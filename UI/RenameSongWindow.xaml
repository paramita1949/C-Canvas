<Window x:Class="ImageColorChanger.UI.RenameSongWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="重命名歌曲" Width="600" Height="440" MinWidth="540" MinHeight="420"
        ResizeMode="CanResize" WindowStartupLocation="CenterOwner" FontFamily="Microsoft YaHei UI"
        Background="{DynamicResource BrushMediaDialogBackground}" Foreground="{DynamicResource BrushMediaDialogText}">
    <Window.Resources>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Height" Value="44"/><Setter Property="MinWidth" Value="104"/><Setter Property="Padding" Value="20,0"/>
            <Setter Property="FontSize" Value="14"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="{DynamicResource BrushMediaDialogSurface}"/><Setter Property="Foreground" Value="{DynamicResource BrushMediaDialogMuted}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushMediaDialogBorder}"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="10"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/></Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.85"/></Trigger>
                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.7"/></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.45"/></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderThickness" Value="3"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="28,24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel><TextBlock Text="给歌曲换个名字" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="实际文件与软件名称同步更新，歌词和关联数据保留。" FontSize="13" Foreground="{DynamicResource BrushMediaDialogMuted}" Margin="0,8,0,0"/></StackPanel>
        <Border Grid.Row="1" Background="{DynamicResource BrushMediaDialogSurface}" CornerRadius="14" BorderThickness="1" BorderBrush="{DynamicResource BrushMediaDialogBorder}" Padding="18" Margin="0,22,0,16">
            <StackPanel>
                <TextBlock Text="歌曲名称" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,10"/>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Border CornerRadius="9" Background="{DynamicResource BrushMediaDialogInput}" BorderBrush="{DynamicResource BrushMediaDialogBorder}" BorderThickness="1" Height="46" Padding="12,0">
                        <TextBox x:Name="NameBox" Foreground="{DynamicResource BrushMediaDialogText}" FontSize="16" BorderThickness="0" Background="Transparent" Padding="0" VerticalContentAlignment="Center" MaxLength="180" TextChanged="NameBox_TextChanged" AutomationProperties.Name="新的歌曲名称">
                            <TextBox.Template><ControlTemplate TargetType="TextBox"><ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/></ControlTemplate></TextBox.Template>
                        </TextBox>
                    </Border>
                    <Border Grid.Column="1" CornerRadius="9" Background="{DynamicResource BrushMediaDialogBackground}" Padding="14,0" Margin="10,0,0,0"><TextBlock x:Name="ExtensionLabel" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource BrushMediaDialogMuted}" VerticalAlignment="Center"/></Border>
                </Grid>
                <TextBlock Text="文件格式保持不变，无需填写扩展名。" FontSize="12" Foreground="{DynamicResource BrushMediaDialogMuted}" Margin="0,10,0,0"/>
            </StackPanel>
        </Border>
        <StackPanel Grid.Row="2"><TextBlock Text="更新后的实际文件" FontSize="11" Foreground="{DynamicResource BrushMediaDialogMuted}"/><TextBlock x:Name="PreviewPath" FontSize="12" Foreground="{DynamicResource BrushMediaDialogMuted}" TextTrimming="CharacterEllipsis" Margin="0,5,0,0"/><TextBlock x:Name="ErrorText" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource BrushBrandDanger}" Margin="0,10,0,0" Visibility="Collapsed"/></StackPanel>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0"><Button x:Name="CancelButton" Content="取消" Style="{StaticResource ActionButton}" Margin="0,0,10,0" Click="CancelButton_Click"/><Button x:Name="ConfirmButton" Content="确认重命名" Style="{StaticResource ActionButton}" Background="{DynamicResource BrushMediaDialogAccent}" Foreground="{DynamicResource BrushMediaDialogOnAccent}" BorderBrush="{DynamicResource BrushMediaDialogAccent}" Click="ConfirmButton_Click" IsDefault="True"/></StackPanel>
    </Grid>
</Window>
