<Window x:Class="ImageColorChanger.UI.MainWindow"
        x:Name="MainWindowRoot"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        xmlns:controls="clr-namespace:ImageColorChanger.UI.Controls"
        xmlns:converters="clr-namespace:ImageColorChanger.UI.Converters"
        xmlns:views="clr-namespace:ImageColorChanger.UI.Views"
        Title="咏慕投影"
        Height="1004" Width="1600"
        MinHeight="800" MinWidth="1400"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="#F5F5F5"
        FontFamily="Microsoft YaHei UI"
        ResizeMode="CanResize"
        Icon="/baodian.ico"
        PreviewKeyDown="Window_PreviewKeyDown"
        Closing="Window_Closing"
        Activated="Window_Activated"
        Loaded="Window_Loaded">

    <Grid x:Name="MainLayoutGrid">
        <Grid.RowDefinitions>
            <RowDefinition x:Name="MenuBarRow" Height="Auto"/>
            <!-- 单排按钮菜单栏 -->
            <RowDefinition Height="*"/>
            <!-- 主内容区 -->

        </Grid.RowDefinitions>

        <!-- ========== 单排按钮菜单栏 ========== -->
        <Border Grid.Row="0" Background="#FAFAFA" BorderBrush="#E0E0E0" BorderThickness="0,0,0,2" Padding="8,0">
            <Border.Effect>
                <DropShadowEffect ShadowDepth="0" BlurRadius="8" Opacity="0.08" Color="#000000"/>
            </Border.Effect>
            <Grid x:Name="TopMenuHostGrid" SizeChanged="TopMenuHostGrid_SizeChanged">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 最左：大箭头（无边框） -->
                <Button x:Name="BtnTopMenuScrollLeft"
                        Grid.Column="0"
                        ToolTip="向左滚动"
                        Style="{StaticResource TopMenuScrollArrowButtonStyle}"
                        Visibility="Collapsed"
                        Click="TopMenuScrollLeft_Click"
                        PreviewMouseLeftButtonDown="TopMenuScrollLeft_PreviewMouseLeftButtonDown"
                        PreviewMouseLeftButtonUp="TopMenuScrollArrow_PreviewMouseLeftButtonUp"
                        MouseLeave="TopMenuScrollArrow_MouseLeave">
                    <Grid Width="12" Height="24">
                        <Path Data="{StaticResource IconLucideChevronLeft}"
                              Width="6"
                              Height="24"
                              HorizontalAlignment="Left"
                              Stretch="Fill"
                              StrokeThickness="2.3"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              StrokeLineJoin="Round"
                              Fill="Transparent"
                              Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"/>
                        <Path Data="{StaticResource IconLucideChevronLeft}"
                              Width="6"
                              Height="24"
                              Margin="4,0,0,0"
                              HorizontalAlignment="Left"
                              Stretch="Fill"
                              StrokeThickness="2.3"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              StrokeLineJoin="Round"
                              Fill="Transparent"
                              Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"/>
                    </Grid>
                </Button>

                <!-- 中间：固定区 + 可滚动区 -->
                <Grid Grid.Column="1" VerticalAlignment="Center" Margin="6,0" ClipToBounds="True">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <ScrollViewer x:Name="TopMenuScrollViewer"
                                  Grid.Column="0"
                                  HorizontalScrollBarVisibility="Hidden"
                                  VerticalScrollBarVisibility="Disabled"
                                  CanContentScroll="False"
                                  PanningMode="HorizontalOnly"
                                  PreviewMouseWheel="TopMenuScrollViewer_PreviewMouseWheel"
                                  ScrollChanged="TopMenuScrollViewer_ScrollChanged"
                                  SizeChanged="TopMenuScrollViewer_SizeChanged"
                                  Loaded="TopMenuScrollViewer_Loaded">
                        <StackPanel x:Name="TopMenuOverflowPanel" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- 基础功能按钮 -->
                    <Button x:Name="BtnImport" Style="{StaticResource MenuButtonStyle}" 
                            ToolTip="导入图片或文件夹" Click="BtnImport_Click" MouseEnter="BtnImport_MouseEnter" MouseLeave="BtnImport_MouseLeave">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconLucideFolderOpen}" Style="{StaticResource LucideIconPathStyle}" Margin="0,0,6,0"/>
                            <TextBlock Text="文件" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnProjection" Style="{StaticResource MenuButtonStyle}"
                            ToolTip="开启/关闭投影" Click="BtnProjection_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconLucideMonitor}" Style="{StaticResource LucideIconPathStyle}" Margin="0,0,6,0"/>
                            <TextBlock Text="投影" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnSync" Style="{StaticResource MenuButtonStyle}"
                            ToolTip="同步所有文件夹" Click="BtnSync_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconLucideRefreshCw}" Style="{StaticResource LucideIconPathStyle}" Margin="0,0,6,0"/>
                            <TextBlock Text="同步" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnReset" Style="{StaticResource MenuButtonStyle}"
                            ToolTip="重置视图" Click="BtnReset_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconLucideUndo2}" Style="{StaticResource LucideIconPathStyle}" Margin="0,0,6,0"/>
                            <TextBlock Text="返回" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnOriginal" Style="{StaticResource MenuButtonStyle}"
                            ToolTip="切换原图模式" Click="BtnOriginal_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconLucideImage}" Style="{StaticResource LucideIconPathStyle}" Margin="0,0,6,0"/>
                            <TextBlock Text="原图" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnZoomReset" Style="{StaticResource MenuButtonStyle}"
                            ToolTip="重置缩放比例" Click="BtnZoomReset_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconLucideSearch}" Style="{StaticResource LucideIconPathStyle}" Margin="0,0,6,0"/>
                            <TextBlock Text="缩放" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnColorEffect" Style="{StaticResource MenuButtonStyle}"
                            ToolTip="切换颜色效果" 
                            Click="BtnColorEffect_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconLucideWand2}" Style="{StaticResource LucideIconPathStyle}" Margin="0,0,6,0"/>
                            <TextBlock Text="变色" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnAiCaption" Style="{StaticResource MenuButtonStyle}"
                            ToolTip="打开 AI字幕 (F4)" Click="BtnAiCaption_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path x:Name="BtnAiCaptionIcon"
                                  Data="{StaticResource IconLucideCaptions}"
                                  Style="{StaticResource LucideIconPathStyle}"
                                  Margin="0,0,6,0"/>
                            <TextBlock x:Name="BtnAiCaptionText"
                                       Text="字幕"
                                       VerticalAlignment="Center"
                                       FontSize="{Binding FontSize, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        </StackPanel>
                    </Button>

                    <!-- 分隔线 -->
                    <Separator x:Name="TopMenuSeparator1" Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="8,0"/>

                    <!-- 关键帧控制按钮 -->
                    <Button x:Name="BtnAddKeyframe" Style="{StaticResource SuccessButtonStyle}"
                            ToolTip="在当前位置添加关键帧" Click="BtnAddKeyframe_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconLucidePlus}" Style="{StaticResource LucideIconPathStyle}" Margin="0,0,6,0"/>
                            <TextBlock Text="加帧" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnClearKeyframes" Style="{StaticResource MenuButtonStyle}"
                            ToolTip="清除所有关键帧" Click="BtnClearKeyframes_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconLucideTrash2}" Style="{StaticResource LucideIconPathStyle}" Margin="0,0,6,0"/>
                            <TextBlock Text="清帧" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnPrevKeyframe" Style="{StaticResource MenuButtonStyle}"
                            ToolTip="跳转到上一个关键帧" Click="BtnPrevKeyframe_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconLucideChevronLeft}" Style="{StaticResource LucideIconPathStyle}" Margin="0,0,6,0"/>
                            <TextBlock Text="上帧" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnNextKeyframe" Style="{StaticResource MenuButtonStyle}"
                            ToolTip="跳转到下一个关键帧" Click="BtnNextKeyframe_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconLucideChevronRight}" Style="{StaticResource LucideIconPathStyle}" Margin="0,0,6,0"/>
                            <TextBlock Text="下帧" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- 分隔线 -->
                    <Separator x:Name="TopMenuSeparator2" Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="8,0"/>
                    <Button x:Name="BtnPlay" Style="{StaticResource MenuButtonStyle}"
                            ToolTip="开始/停止自动播放" Click="BtnPlay_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconLucidePlay}" Style="{StaticResource LucideIconPathStyle}" Margin="0,0,6,0"/>
                            <TextBlock Text="播放" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- 播放控制按钮 -->
                    <Button x:Name="BtnPlayCount" Style="{StaticResource MenuButtonStyle}"
                            ToolTip="单击循环切换，双击输入数字，滚轮微调 (1-10或∞)" 
                            Click="BtnPlayCount_Click"
                            MouseWheel="BtnPlayCount_MouseWheel"
                            MouseDoubleClick="BtnPlayCount_MouseDoubleClick">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconLucideRepeat}" Style="{StaticResource LucideIconPathStyle}" Margin="0,0,6,0"/>
                            <TextBlock Text="5次" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnRecord" Content="录制" Style="{StaticResource RecordButtonStyle}"
                            ToolTip="开始/停止时间录制" 
                            Click="BtnRecord_Click"/>
                    <Button x:Name="BtnScript" Style="{StaticResource MenuButtonStyle}"
                            ToolTip="显示脚本信息" Click="BtnScript_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconLucideFileText}" Style="{StaticResource LucideIconPathStyle}" Margin="0,0,6,0"/>
                            <TextBlock Text="脚本" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnClearTiming" Style="{StaticResource MenuButtonStyle}"
                            ToolTip="清除时间录制数据" Click="BtnClearTiming_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconLucideTimerReset}" Style="{StaticResource LucideIconPathStyle}" Margin="0,0,6,0"/>
                            <TextBlock Text="清时" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- 分隔线 -->
                    <Separator x:Name="TopMenuSeparator3" Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="3,0"/>
                    <Button x:Name="BtnPauseResume" Style="{StaticResource MenuButtonStyle}"
                            ToolTip="暂停/继续播放" Click="BtnPauseResume_Click" Margin="-1,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconLucidePause}" Style="{StaticResource LucideIconPathStyle}" Margin="0,0,6,0"/>
                            <TextBlock Text="暂停" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- 倒计时显示 - 无边框，黄色底 -->
                    <Border x:Name="CountdownBorder" Background="#FFFFCC" 
                            BorderThickness="0"
                            CornerRadius="4" Padding="8,2" Margin="3,0" Width="110"
                            VerticalAlignment="Center"
                            Cursor="Hand"
                            ToolTip="双击：应用已播放时间 | 右键：应用/修改"
                            MouseLeftButtonDown="CountdownBorder_MouseLeftButtonDown"
                            MouseRightButtonUp="CountdownBorder_MouseRightButtonUp">
                        <TextBlock x:Name="CountdownText" Text="|" FontSize="18" 
                                   FontWeight="Bold" Foreground="#CC6600" 
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <!-- 暂停/继续按钮 -->
                    <Button x:Name="BtnLogin" Content="登录" Style="{StaticResource BreathingContactButtonStyle}"
                            ToolTip="登录账号解除投影限制" Click="BtnLogin_Click" Margin="15,0,4,0"/>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- 左右遮罩：隐藏被裁切按钮的边框残影（如蓝色竖边） -->
                    <Border Width="10"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Stretch"
                            Background="#FAFAFA"
                            IsHitTestVisible="False"/>
                    <Border Width="10"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Stretch"
                            Background="#FAFAFA"
                            IsHitTestVisible="False"/>
                </Grid>

                <!-- 最右：大箭头（无边框） -->
                <Button x:Name="BtnTopMenuScrollRight"
                        Grid.Column="2"
                        ToolTip="向右滚动"
                        Style="{StaticResource TopMenuScrollArrowButtonStyle}"
                        Visibility="Collapsed"
                        Click="TopMenuScrollRight_Click"
                        PreviewMouseLeftButtonDown="TopMenuScrollRight_PreviewMouseLeftButtonDown"
                        PreviewMouseLeftButtonUp="TopMenuScrollArrow_PreviewMouseLeftButtonUp"
                        MouseLeave="TopMenuScrollArrow_MouseLeave">
                    <Grid Width="12" Height="24">
                        <Path Data="{StaticResource IconLucideChevronRight}"
                              Width="6"
                              Height="24"
                              HorizontalAlignment="Left"
                              Stretch="Fill"
                              StrokeThickness="2.3"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              StrokeLineJoin="Round"
                              Fill="Transparent"
                              Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"/>
                        <Path Data="{StaticResource IconLucideChevronRight}"
                              Width="6"
                              Height="24"
                              Margin="4,0,0,0"
                              HorizontalAlignment="Left"
                              Stretch="Fill"
                              StrokeThickness="2.3"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              StrokeLineJoin="Round"
                              Fill="Transparent"
                              Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"/>
                    </Grid>
                </Button>

            </Grid>
        </Border>

        <!-- ========== 主内容区 ========== -->
        <Grid Grid.Row="1" x:Name="MainContentGrid">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <!-- 右侧画面 -->
                <RowDefinition Height="Auto"/>
                <!-- 右侧媒体控制栏；左侧导航跨两行，不随播放栏显隐改变高度 -->
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="NavigationPanelColumn" Width="370"/>
                <!-- 左侧导航栏（圣经模式5列表格需要370宽度） -->
                <ColumnDefinition Width="Auto"/>
                <!-- 分隔条 -->
                <ColumnDefinition Width="*"/>
                <!-- 右侧图片显示区 -->
            </Grid.ColumnDefinitions>

            <!-- 左侧：文件导航栏 -->
            <Border Grid.Column="0" Grid.RowSpan="2" Background="White" BorderBrush="#E0E0E0" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <!-- 搜索区域 -->
                        <RowDefinition Height="*"/>
                        <!-- 项目树 -->
                        <RowDefinition Height="Auto"/>
                        <!-- 屏幕选择 -->
                    </Grid.RowDefinitions>

                    <!-- 搜索区域 -->
                    <StackPanel Grid.Row="0" Background="White" Margin="8">
                        <Grid Margin="0,4,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- 搜索框 -->
                            <TextBox x:Name="SearchBox"
                                     Grid.Column="0"
                                     Height="40"
                                     Margin="0"
                                     Padding="12,8"
                                     materialDesign:HintAssist.Hint="搜索（双击左键清除内容）"
                                     materialDesign:HintAssist.Foreground="#666666"
                                     materialDesign:TextFieldAssist.UnderlineBrush="#2196F3"
                                     Style="{StaticResource MaterialDesignFilledTextBox}"
                                     TextChanged="SearchBox_TextChanged"
                                     PreviewKeyDown="SearchBox_PreviewKeyDown"
                                     MouseDoubleClick="SearchBox_MouseDoubleClick"
                                     FontSize="14"
                                     Foreground="Black"
                                     VerticalContentAlignment="Center"/>

                            <Button x:Name="SearchClearButton"
                                    Grid.Column="1"
                                    Style="{StaticResource SearchClearButtonStyle}"
                                    Width="30"
                                    Height="30"
                                    Margin="6,0,0,0"
                                    Padding="0"
                                    Content="×"
                                    FontSize="16"
                                    FontWeight="Bold"
                                    VerticalAlignment="Center"
                                    Visibility="Collapsed"
                                    ToolTip="清空搜索"
                                    Click="SearchClearButton_Click"/>

                            <StackPanel x:Name="BibleSearchModePanel"
                                        Grid.Column="2"
                                        Orientation="Horizontal"
                                        Margin="10,0,0,0"
                                        VerticalAlignment="Center"
                                        Visibility="Collapsed">
                                <TextBlock x:Name="BibleSearchModeFloatingText"
                                           Text="悬浮"
                                           FontSize="18"
                                           Cursor="Hand"
                                           Margin="0,0,4,0"
                                           VerticalAlignment="Center"
                                           MouseLeftButtonDown="BibleSearchModeFloatingText_MouseLeftButtonDown"/>
                                <TextBlock Text="|"
                                           FontSize="18"
                                           Foreground="#9E9E9E"
                                           Margin="0,0,4,0"
                                           VerticalAlignment="Center"/>
                                <TextBlock x:Name="BibleSearchModeEmbeddedText"
                                           Text="内嵌"
                                           FontSize="18"
                                           Cursor="Hand"
                                           VerticalAlignment="Center"
                                           MouseLeftButtonDown="BibleSearchModeEmbeddedText_MouseLeftButtonDown"/>
                            </StackPanel>

                            <StackPanel x:Name="IncludeMediaSearchModePanel"
                                        Grid.Column="2" Orientation="Vertical"
                                        Width="108" Margin="8,0,0,0" VerticalAlignment="Center">
                                <Grid Margin="0,0,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="ImageSearchFilterText" Grid.Column="1" Text="图片" FontSize="14"
                                               Cursor="Hand" Foreground="#757575" Padding="4,1" TextAlignment="Center" Margin="0,0,4,0"
                                               ToolTip="搜索本地图片；与媒体可同时选择" MouseLeftButtonDown="ImageSearchFilterText_MouseLeftButtonDown"/>
                                    <TextBlock x:Name="MediaSearchFilterText" Grid.Column="2" Text="媒体" FontSize="14"
                                               Cursor="Hand" Foreground="#757575" Padding="4,1" TextAlignment="Center"
                                               ToolTip="搜索本地视频/音频；与图片可同时选择" MouseLeftButtonDown="MediaSearchFilterText_MouseLeftButtonDown"/>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid x:Name="OnlineScoreNetworkIcon" Width="16" Height="16"
                                          HorizontalAlignment="Left" VerticalAlignment="Center"
                                          ToolTip="联网搜索：按歌名或歌词查找歌谱"
                                          AutomationProperties.Name="联网搜索"
                                          Loaded="OnlineScoreNetworkIcon_Loaded"
                                          Unloaded="OnlineScoreNetworkIcon_Unloaded"
                                          IsVisibleChanged="OnlineScoreNetworkIcon_IsVisibleChanged">
                                        <Ellipse Width="10" Height="10">
                                            <Ellipse.Fill>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#42C8D7" Offset="0"/>
                                                    <GradientStop Color="#1976D2" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Ellipse.Fill>
                                        </Ellipse>
                                        <Path Data="M8,3 C5.3,5 5.3,11 8,13 M8,3 C10.7,5 10.7,11 8,13 M3,8 L13,8"
                                              Stroke="#E7FBFF" StrokeThickness="0.65" Opacity="0.9"/>
                                        <!-- 彩色轨道只在真实搜索期间转动，不代表网络一定可用。 -->
                                        <Path Data="M2.2,4.3 A6.9,6.9 0 0 1 13.8,4.3 M13.8,11.7 A6.9,6.9 0 0 1 2.2,11.7"
                                              StrokeThickness="1.35" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                                            <Path.Stroke>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#1976D2" Offset="0"/>
                                                    <GradientStop Color="#20BFA9" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Path.Stroke>
                                            <Path.RenderTransform>
                                                <RotateTransform x:Name="OnlineScoreNetworkRotation" CenterX="8" CenterY="8"/>
                                            </Path.RenderTransform>
                                        </Path>
                                    </Grid>
                                    <TextBlock x:Name="ScoreNameSearchText" Grid.Column="1" Text="歌谱" FontSize="14" Cursor="Hand" Foreground="#757575"
                                               Padding="4,1" TextAlignment="Center" Margin="0,0,4,0"
                                               ToolTip="联网：按歌名搜索歌谱" MouseLeftButtonDown="ScoreNameSearchText_MouseLeftButtonDown"/>
                                    <TextBlock x:Name="ScoreLyricsSearchText" Grid.Column="2" Text="歌词" FontSize="14" Cursor="Hand" Foreground="#757575"
                                               Padding="4,1" TextAlignment="Center"
                                               ToolTip="联网：按歌词搜索歌谱" MouseLeftButtonDown="ScoreLyricsSearchText_MouseLeftButtonDown"/>
                                </Grid>
                            </StackPanel>
                        </Grid>

                        <Popup x:Name="BibleSearchPopup"
                               PlacementTarget="{Binding ElementName=SearchBox}"
                               Placement="Bottom"
                               StaysOpen="False"
                               AllowsTransparency="True"
                               PopupAnimation="Fade">
                            <Border Background="#FFFFFF"
                                    BorderBrush="#D6D6D6"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="8"
                                    MinWidth="420"
                                    MaxWidth="980"
                                    MaxHeight="720">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock x:Name="BibleSearchResultStatus"
                                               Foreground="#666666"
                                               FontSize="12"
                                               Margin="2,0,2,6"/>

                                    <Grid x:Name="BibleSearchFilterTagsPanel"
                                          Grid.Row="1"
                                          Margin="0,0,0,6"/>

                                    <ListBox x:Name="BibleSearchResultsList"
                                             Grid.Row="2"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             ScrollViewer.VerticalScrollBarVisibility="Hidden"
                                             ScrollViewer.HorizontalScrollBarVisibility="Hidden">
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="Padding" Value="2,2"/>
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Foreground="#111111"
                                                           FontSize="{Binding FontSize, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                           TextWrapping="Wrap">
                                                    <Run Text="{Binding RowNumber}"/>
                                                    <Run Text=". "/>
                                                    <Run Text="["/>
                                                    <Run Text="{Binding Reference}"/>
                                                    <Run Text="] "/>
                                                    <Run Text="{Binding FullPrefix}"/>
                                                    <Run Text="{Binding FullMatch}"
                                                         Foreground="#1E88E5"
                                                         FontWeight="Bold"/>
                                                    <Run Text="{Binding FullSuffix}"/>
                                                </TextBlock>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>

                                    <StackPanel Grid.Row="3"
                                                Orientation="Horizontal"
                                                HorizontalAlignment="Right"
                                                Margin="0,6,0,0">
                                        <Button x:Name="BibleSearchPrevPageButton"
                                                Content="上一页"
                                                Padding="8,2"
                                                Margin="0,0,8,0"/>
                                        <TextBlock x:Name="BibleSearchPageInfoText"
                                                   VerticalAlignment="Center"
                                                   Foreground="#666666"
                                                   Margin="0,0,8,0"/>
                                        <Button x:Name="BibleSearchNextPageButton"
                                                Content="下一页"
                                                Padding="8,2"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Popup>

                        <!-- 搜索范围 -->
                        <ComboBox x:Name="SearchScope" 
                                  Style="{StaticResource WhiteComboBoxPopup}"
                                  ItemContainerStyle="{StaticResource WhiteComboBoxItem}">
                            <ComboBoxItem Content="全部" IsSelected="True" Style="{StaticResource WhiteComboBoxItem}"/>
                            <ComboBoxItem Content="当前文件夹" Style="{StaticResource WhiteComboBoxItem}"/>
                        </ComboBox>
                        
                        <!--  文件/圣经/幻灯片 切换按钮 -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,8">
                            <Button x:Name="BtnShowFiles"
                                    Content="文件"
                                    Style="{StaticResource NavToggleButtonLeft}"
                                    Background="#2196F3"
                                    Foreground="White"
                                    BorderBrush="#1976D2"
                                    BorderThickness="1"
                                    Click="BtnShowFiles_Click"/>
                            <Button x:Name="BtnShowBible"
                                    Content="圣经"
                                    Style="{StaticResource NavToggleButtonMiddle}"
                                    Background="#FFFFFF"
                                    Foreground="#666666"
                                    BorderBrush="#E0E0E0"
                                    BorderThickness="0,1,1,1"
                                    Click="BtnShowBible_Click"/>
                            <Button x:Name="BtnShowProjects"
                                    Content="幻灯片"
                                    Style="{StaticResource NavToggleButtonRight}"
                                    Background="#FFFFFF"
                                    Foreground="#666666"
                                    BorderBrush="#E0E0E0"
                                    BorderThickness="0,1,1,1"
                                    Click="BtnShowProjects_Click"/>
                        </StackPanel>
                        <!-- 仅纯数字搜索出现：本地文件夹二次筛选，不混入在线歌本。 -->
                        <Grid x:Name="ProjectSearchFolderTagsPanel" Visibility="Collapsed" Margin="0,0,0,4">
                            <Grid.Resources>
                                <Style x:Key="ProjectSearchFolderChip" TargetType="ToggleButton">
                                    <Setter Property="Background" Value="{DynamicResource BrushMenuSurface}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource BrushMenuText}"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource BrushMenuBorder}"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Setter Property="Padding" Value="10,4"/>
                                    <Setter Property="Margin" Value="0,0,5,5"/>
                                    <Setter Property="MinHeight" Value="28"/>
                                    <Setter Property="MaxWidth" Value="180"/>
                                    <Setter Property="FontSize" Value="12"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border x:Name="ChipBorder" CornerRadius="8" Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ChipBorder" Property="Background" Value="{DynamicResource BrushMenuHover}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsKeyboardFocused" Value="True">
                                                        <Setter TargetName="ChipBorder" Property="BorderBrush" Value="{DynamicResource BrushMenuText}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter TargetName="ChipBorder" Property="Background" Value="{DynamicResource BrushMenuSubSurface}"/>
                                                        <Setter TargetName="ChipBorder" Property="BorderBrush" Value="{DynamicResource BrushMenuText}"/>
                                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Grid.Resources>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ScrollViewer x:Name="ProjectSearchFolderTagsScroll" MaxHeight="64" ClipToBounds="True"
                                          HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Disabled">
                                <WrapPanel x:Name="ProjectSearchFolderTagsWrap"/>
                            </ScrollViewer>
                            <ToggleButton x:Name="ProjectSearchFolderTagsMore" Grid.Column="1" Content="更多" Visibility="Collapsed"
                                          VerticalAlignment="Top" Style="{StaticResource ProjectSearchFolderChip}" ToolTip="展开文件夹标签"/>
                        </Grid>
                    </StackPanel>

                    <!--  圣经导航面板（圣经模式下显示） -->
                    <Grid Grid.Row="1" x:Name="BibleNavigationPanel" Visibility="Collapsed" Background="#2D2D30">
                        <Grid.RowDefinitions>
                            <RowDefinition x:Name="BibleHistoryAndButtonRow" Height="*" MinHeight="150"/>    <!-- 历史记录+按钮（可调整高度，最小150像素） -->
                            <RowDefinition Height="3"/>       <!-- 分隔条（可拖拽调整） -->
                            <RowDefinition x:Name="BibleSelectionTableRow" Height="*" MinHeight="180"/>       <!-- 经文选择表格（可调整高度，最小180像素，约显示5个记录） -->
                        </Grid.RowDefinitions>
                        
                        <!-- 历史记录和按钮容器 -->
                        <Grid Grid.Row="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>    <!-- 历史记录（占用剩余空间） -->
                                <RowDefinition Height="Auto"/>    <!-- 历史操作按钮（固定） -->
                            </Grid.RowDefinitions>
                        
                        <!-- 历史记录列表（显示1-20号槽位） -->
                        <ScrollViewer x:Name="BibleHistoryScrollViewer" Grid.Row="0" VerticalScrollBarVisibility="Auto" Background="#3C3C3C">
                            <ListBox x:Name="BibleHistoryList" 
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Margin="5"
                                     SelectionChanged="BibleHistoryList_SelectionChanged"
                                     PreviewMouseWheel="BibleHistoryList_PreviewMouseWheel"
                                     ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="Margin" Value="0"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="Background" Value="#FF5722"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border x:Name="HistoryItemBorder"
                                                Background="#2D2D30" 
                                                BorderBrush="#4D4D4D" 
                                                BorderThickness="0,0,0,1"
                                                Padding="8,6"
                                                Cursor="Hand"
                                                MouseEnter="BibleHistoryItem_MouseEnter"
                                                MouseLeave="BibleHistoryItem_MouseLeave"
                                                MouseLeftButtonDown="BibleHistoryItem_Click">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>  <!-- 复选框 -->
                                                    <ColumnDefinition Width="Auto"/>  <!-- 序号 -->
                                                    <ColumnDefinition Width="*"/>     <!-- 内容 -->
                                                </Grid.ColumnDefinitions>
                                                
                                                <!-- 复选框 -->
                                                <CheckBox Grid.Column="0" 
                                                          IsChecked="{Binding IsChecked}" 
                                                          VerticalAlignment="Center"
                                                          Margin="0,0,5,0"
                                                          Foreground="White"
                                                          IsHitTestVisible="False"/>
                                                
                                                <!-- 序号 -->
                                                <TextBlock Grid.Column="1" 
                                                           Text="{Binding Index}" 
                                                           Foreground="#FFC107" 
                                                           FontSize="14" 
                                                           FontWeight="Bold"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,5,0"/>
                                                
                                                <!-- 经文信息 -->
                                                <TextBlock Grid.Column="2" 
                                                           Text="{Binding DisplayText}" 
                                                           Foreground="White" 
                                                           FontSize="13"
                                                           VerticalAlignment="Center"
                                                           Margin="0"/>
                                            </Grid>
                                        </Border>
                                        
                                        <!-- DataTemplate Triggers -->
                                        <DataTemplate.Triggers>
                                            <!-- 锁定状态：绿色边框（最高优先级） -->
                                            <DataTrigger Binding="{Binding IsLocked}" Value="True">
                                                <Setter TargetName="HistoryItemBorder" Property="BorderBrush" Value="#00FF00"/>
                                                <Setter TargetName="HistoryItemBorder" Property="BorderThickness" Value="3"/>
                                            </DataTrigger>
                                            
                                            <!-- 鼠标悬停：简单的灰色背景高亮（仅在未锁定时生效） -->
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsLocked}" Value="False"/>
                                                    <Condition Binding="{Binding ElementName=HistoryItemBorder, Path=IsMouseOver}" Value="True"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter TargetName="HistoryItemBorder" Property="Background" Value="#3E3E42"/>
                                            </MultiDataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </ScrollViewer>

                        <Popup x:Name="BibleHistoryPreviewPopup"
                               Placement="Right"
                               PlacementTarget="{Binding ElementName=BibleHistoryList}"
                               HorizontalOffset="8"
                               VerticalOffset="0"
                               AllowsTransparency="True"
                               StaysOpen="True"
                               Focusable="False"
                               IsHitTestVisible="True"
                               PopupAnimation="Fade">
                            <Border Background="#EE101828"
                                    BorderBrush="#335D6B84"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="14"
                                    Width="430"
                                    SnapsToDevicePixels="True"
                                    MouseEnter="BibleHistoryPreviewPopup_MouseEnter"
                                    MouseLeave="BibleHistoryPreviewPopup_MouseLeave">
                                <StackPanel>
                                    <TextBlock x:Name="BibleHistoryPreviewReferenceText"
                                               Text=""
                                               Foreground="#FFB8D7FF"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Margin="0,0,0,8"
                                               TextTrimming="CharacterEllipsis"/>
                                    <Border Background="#22000000"
                                            BorderBrush="#33475567"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="8">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                      HorizontalScrollBarVisibility="Disabled"
                                                      MaxHeight="300">
                                            <TextBlock x:Name="BibleHistoryPreviewContentText"
                                                       Text=""
                                                       Foreground="#FFF8FAFC"
                                                       FontSize="13"
                                                       TextWrapping="Wrap"
                                                       LineHeight="24"/>
                                        </ScrollViewer>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </Popup>
                            
                            <!-- 历史操作按钮 -->
                            <Border Grid.Row="1" Background="#3C3C3C" BorderBrush="#4D4D4D" BorderThickness="0,0,0,1" Padding="5">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button x:Name="BtnHistorySelectAll" 
                                        Content="全选" 
                                        Width="80" 
                                        Height="30" 
                                        FontSize="12"
                                        Margin="2"
                                        Style="{StaticResource MenuButtonStyle}"
                                        Click="BtnHistorySelectAll_Click"/>
                                <Button x:Name="BtnHistoryDeselectAll" 
                                        Content="全不选" 
                                        Width="80" 
                                        Height="30" 
                                        FontSize="12"
                                        Margin="2"
                                        Style="{StaticResource MenuButtonStyle}"
                                        Click="BtnHistoryDeselectAll_Click"/>
                                <Button x:Name="BtnHistoryClearSelected" 
                                        Content="清空勾选" 
                                        Width="100" 
                                        Height="30" 
                                        FontSize="12"
                                        Margin="2"
                                        Style="{StaticResource MenuButtonStyle}"
                                        Click="BtnHistoryClearSelected_Click"/>
                                <Button x:Name="BtnBibleSettings" 
                                        Width="80" 
                                        Height="30" 
                                        FontSize="12"
                                        Margin="2"
                                        Style="{StaticResource MenuButtonStyle}"
                                        Click="BtnBibleSettings_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconLucideBookSliders}" Style="{StaticResource LucideIconPathStyle}" Width="14" Height="14" Margin="0,0,4,0"/>
                                        <TextBlock Text="设置" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                        </Grid>
                        
                        <!-- 分隔条（可拖拽调整历史记录+按钮区域和经文选择表格之间的高度） -->
                        <GridSplitter x:Name="BibleNavigationSplitter"
                                     Grid.Row="1" 
                                     Height="3" 
                                     HorizontalAlignment="Stretch" 
                                     Background="#555555" 
                                     Cursor="SizeNS"
                                     ResizeDirection="Rows"
                                     ShowsPreview="False"
                                     DragCompleted="BibleNavigationSplitter_DragCompleted"/>
                        
                        <!-- 经文选择表格 -->
                        <!-- 5列表格布局：分类 | 书卷 | 章 | 起始节 | 结束节 -->
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="85"/>   <!-- 第1列:分类(4个字宽度) -->
                                <ColumnDefinition Width="120"/>  <!-- 第2列:书卷 -->
                                <ColumnDefinition Width="65"/>   <!-- 第3列:章 -->
                                <ColumnDefinition Width="60"/>   <!-- 第4列:起始节 -->
                                <ColumnDefinition Width="60"/>   <!-- 第5列:结束节 -->
                            </Grid.ColumnDefinitions>
                            
                            <!-- 第1列:分类列表 -->
                            <ListBox Grid.Column="0" 
                                     x:Name="BibleCategoryList"
                                     Background="#3C3C3C"
                                     BorderThickness="0,0,1,0"
                                     BorderBrush="#555555"
                                     SelectionChanged="BibleCategory_SelectionChanged"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="FontSize" Value="13"/>
                                        <Setter Property="Padding" Value="8,6"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Setter Property="Foreground" Value="#FF5722"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#4D4D4D"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" 
                                                   TextWrapping="NoWrap" 
                                                   TextTrimming="None"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            
                            <!-- 第2列:书卷列表 -->
                            <ListBox Grid.Column="1" 
                                     x:Name="BibleBookList"
                                     Background="#3C3C3C"
                                     BorderThickness="0,0,1,0"
                                     BorderBrush="#555555"
                                     SelectionChanged="BibleBook_SelectionChanged"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="FontSize" Value="12"/>
                                        <Setter Property="Padding" Value="8,6"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Setter Property="Foreground" Value="#FF5722"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#4D4D4D"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" 
                                                   TextWrapping="NoWrap" 
                                                   TextTrimming="None"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            
                            <!-- 第3列:章列表 -->
                            <ListBox Grid.Column="2" 
                                     x:Name="BibleChapterList"
                                     Background="#3C3C3C"
                                     BorderThickness="0,0,1,0"
                                     BorderBrush="#555555"
                                     SelectionChanged="BibleChapter_SelectionChanged"
                                     MouseDoubleClick="BibleChapter_MouseDoubleClick"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="FontSize" Value="14"/>
                                        <Setter Property="Padding" Value="10,8"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Setter Property="Foreground" Value="#FF5722"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#4D4D4D"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                            </ListBox>
                            
                            <!-- 第4列:起始节 -->
                            <ListBox Grid.Column="3" 
                                     x:Name="BibleStartVerse"
                                     Background="#3C3C3C"
                                     BorderThickness="0,0,1,0"
                                     BorderBrush="#555555"
                                     SelectionChanged="BibleStartVerse_SelectionChanged"
                                     MouseDoubleClick="BibleStartVerse_MouseDoubleClick"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="FontSize" Value="14"/>
                                        <Setter Property="Padding" Value="10,8"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Setter Property="Foreground" Value="#FF5722"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#4D4D4D"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                            </ListBox>
                            
                            <!-- 第5列:结束节 -->
                            <ListBox Grid.Column="4" 
                                     x:Name="BibleEndVerse"
                                     Background="#3C3C3C"
                                     BorderThickness="0"
                                     SelectionChanged="BibleEndVerse_SelectionChanged"
                                     MouseLeftButtonUp="BibleEndVerse_MouseLeftButtonUp"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="FontSize" Value="14"/>
                                        <Setter Property="Padding" Value="10,8"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Setter Property="Foreground" Value="#FF5722"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#4D4D4D"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                            </ListBox>
                        </Grid>
                    </Grid>
                    
                    <!-- 在线结果独立于本地树模型，沿用搜索框和导航区。 -->
                    <Grid x:Name="OnlineScorePanel" Grid.Row="1" Visibility="Collapsed" Margin="8,0,8,8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Margin="4,6,4,8">
                            <TextBlock x:Name="OnlineScoreStatus" Text="使用上方搜索框输入歌名或歌词。"
                                       Foreground="#666666" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,7"/>
                            <StackPanel Orientation="Horizontal"
                                        ToolTip="按已确认的歌谱元数据筛选；类型尚未识别时保留在全部中。同一首可同时有结构化谱和原始图片。">
                                <TextBlock x:Name="ScoreKindAllText" Text="全部" FontSize="13" Cursor="Hand" Foreground="#1976D2" FontWeight="SemiBold"
                                           MouseLeftButtonDown="ScoreKindAllText_MouseLeftButtonDown"/>
                                <TextBlock x:Name="ScoreKindStructuredText" Text="结构化" FontSize="13" Cursor="Hand" Foreground="#757575" Margin="18,0,0,0"
                                           ToolTip="有普通或大字结构化谱文；不代表所有语法都能正确渲染"
                                           MouseLeftButtonDown="ScoreKindStructuredText_MouseLeftButtonDown"/>
                                <TextBlock x:Name="ScoreKindImageText" Text="普通图片" FontSize="13" Cursor="Hand" Foreground="#757575" Margin="18,0,0,0"
                                           ToolTip="目录确认有官方原始位图；不是结构化谱生成的PNG，也不保证节点当前可下载"
                                           MouseLeftButtonDown="ScoreKindImageText_MouseLeftButtonDown"/>
                            </StackPanel>
                        </StackPanel>
                        <ListBox x:Name="OnlineScoreList" Grid.Row="1" Background="Transparent" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                 SelectionMode="Single"
                                 PreviewMouseLeftButtonDown="OnlineScoreList_PreviewMouseLeftButtonDown"
                                 PreviewMouseLeftButtonUp="OnlineScoreList_PreviewMouseLeftButtonUp"
                                 SelectionChanged="OnlineScoreList_SelectionChanged">
                            <ListBox.Resources>
                                <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource ProjectTreeScrollBarStyle}"/>
                            </ListBox.Resources>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Padding" Value="8,10"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                                        Padding="{TemplateBinding Padding}" BorderThickness="0"
                                                        SnapsToDevicePixels="True">
                                                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushMenuHover}"/>
                                                        <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="#FFD54F"/>
                                                        <Setter Property="Foreground" Value="#212121"/>
                                                    </Trigger>
                                                    <MultiTrigger>
                                                        <MultiTrigger.Conditions>
                                                            <Condition Property="IsSelected" Value="True"/>
                                                            <Condition Property="Selector.IsSelectionActive" Value="False"/>
                                                        </MultiTrigger.Conditions>
                                                        <Setter TargetName="Bd" Property="Background" Value="#FFF59D"/>
                                                        <Setter Property="Foreground" Value="#424242"/>
                                                    </MultiTrigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Loaded="OnlineScoreResult_Loaded" DataContextChanged="OnlineScoreResult_DataContextChanged">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="ScoreNumberText" Text="{Binding NumberLabel}" FontSize="24" FontWeight="SemiBold"
                                                   Foreground="#37474F" MinWidth="44" MaxWidth="72" Margin="0,0,12,0"
                                                   VerticalAlignment="Center" TextAlignment="Right"
                                                   ToolTip="歌本中的曲目编号，不是搜索排序序号"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock x:Name="ScoreResultTitleText" Text="{Binding Name}" FontSize="18" FontWeight="Bold"
                                                       Foreground="#222222" TextWrapping="Wrap"/>
                                            <TextBlock x:Name="ScoreResultBookText" Text="{Binding BookDisplayName}" FontSize="13"
                                                       Foreground="#757575" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center">
                                            <Grid x:Name="ScoreDownloadSpinner" Width="16" Height="16" Margin="0,0,0,4"
                                                  HorizontalAlignment="Right" ToolTip="正在准备歌谱，请稍候"
                                                  Loaded="ScoreDownloadSpinner_Loaded" Unloaded="ScoreDownloadSpinner_Unloaded"
                                                  IsVisibleChanged="ScoreDownloadSpinner_IsVisibleChanged"
                                                  AutomationProperties.Name="正在准备所选歌谱">
                                                <Path Stroke="#2196B5" StrokeThickness="2" Data="M 8,1 A 7,7 0 1 1 1,8"
                                                      RenderTransformOrigin="0.5,0.5">
                                                    <Path.RenderTransform>
                                                        <RotateTransform x:Name="ScoreDownloadRotation"/>
                                                    </Path.RenderTransform>
                                                </Path>
                                                <Grid.Style>
                                                    <Style TargetType="Grid">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsPreparingDownload}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Grid.Style>
                                            </Grid>
                                            <StackPanel x:Name="StructuredAvailableBadge" Orientation="Horizontal" Margin="0,0,0,3"
                                                        ToolTip="有结构化谱文，可重新排版；复杂语法支持与下载是否成功需另行验证"
                                                        AutomationProperties.Name="有结构化歌谱">
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasStructured}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>
                                                <Ellipse Width="6" Height="6" Fill="#1976D2" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="结构化" FontSize="11" Foreground="#1976D2"/>
                                            </StackPanel>
                                            <StackPanel x:Name="LyricsAvailableBadge" Orientation="Horizontal"
                                                        ToolTip="有完整歌词，打开图片后可使用图片－歌词功能" AutomationProperties.Name="有歌词">
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasLyrics}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>
                                                <Ellipse x:Name="LyricsAvailableDot" Width="6" Height="6" Fill="#219653" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="歌词" FontSize="11" Foreground="#219653"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock x:Name="OnlineScoreLyricsPreview" Grid.Row="2" TextWrapping="Wrap" FontSize="12" Margin="4,8,4,4"/>
                    </Grid>

                    <!-- 项目树（文件模式下显示） -->
                    <Grid Grid.Row="1" x:Name="LocalLibraryLayout"
                          Visibility="{Binding ElementName=ProjectTree, Path=Visibility}"
                          SizeChanged="LocalLibraryLayout_SizeChanged">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition x:Name="OnlineLibrarySplitterRow" Height="0"/>
                            <RowDefinition x:Name="OnlineLibraryPaneRow" Height="0"/>
                        </Grid.RowDefinitions>
                    <TreeView Grid.Row="0" x:Name="ProjectTree"
                                  Style="{StaticResource ProjectTreeStyle}"
                                  VirtualizingPanel.IsVirtualizing="True"
                                  VirtualizingPanel.VirtualizationMode="Recycling"
                                  VirtualizingStackPanel.ScrollUnit="Pixel"
                                  ScrollViewer.CanContentScroll="True"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  PreviewKeyDown="Window_PreviewKeyDown"
                                  PreviewMouseLeftButtonDown="ProjectTree_PreviewFolderDoubleClick"
                                  PreviewMouseLeftButtonUp="ProjectTree_MouseClick"
                                  MouseDoubleClick="ProjectTree_MouseDoubleClick"
                                  PreviewMouseRightButtonDown="ProjectTree_RightClick"
                                  MouseMove="ProjectTree_MouseMove"
                                  AllowDrop="True"
                                  Drop="ProjectTree_ExternalDrop"
                                  DragEnter="ProjectTree_ExternalDragEnter"
                                  DragOver="ProjectTree_ExternalDragOver"
                                  DragLeave="ProjectTree_ExternalDragLeave">
                        <TreeView.Resources>
                            <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource ProjectTreeScrollBarStyle}"/>
                        </TreeView.Resources>
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                                <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=OneWay}"/>
                                <EventSetter Event="MouseEnter" Handler="TreeViewItem_MouseEnter"/>
                                <EventSetter Event="MouseLeave" Handler="TreeViewItem_MouseLeave"/>
                                <!-- 自定义模板：对于文件节点隐藏展开/折叠按钮 -->
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="TreeViewItem">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition x:Name="ExpanderColumn" Width="0"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition/>
                                                </Grid.RowDefinitions>

                                                <!-- 独立分隔栏不占文件/歌词节点，不参与选中高亮。 -->
                                                <Border x:Name="OnlineLibrarySeparator" Grid.ColumnSpan="2"
                                                        BorderBrush="#D7E5E2" BorderThickness="0,1,0,0"
                                                        Margin="0,12,0,6" Padding="4,7,0,0"
                                                        IsHitTestVisible="False" Visibility="Collapsed">
                                                    <TextBlock Text="在线歌谱" Foreground="#64867F" FontSize="12"/>
                                                </Border>
                                                
                                                <!-- 展开/折叠按钮（仅虚拟子目录显示，主题联动） -->
                                                <ToggleButton x:Name="Expander" 
                                                              Grid.Column="0"
                                                              Grid.Row="1"
                                                              Width="16"
                                                              Height="16"
                                                              Margin="0,0,4,0"
                                                              VerticalAlignment="Center"
                                                              HorizontalAlignment="Center"
                                                              Focusable="False"
                                                              IsHitTestVisible="False"
                                                              ClickMode="Press"
                                                              IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}">
                                                    <ToggleButton.Template>
                                                        <ControlTemplate TargetType="ToggleButton">
                                                            <materialDesign:PackIcon x:Name="ExpanderGlyph"
                                                                                     Kind="PlusBoxOutline"
                                                                                     Width="14"
                                                                                     Height="14"
                                                                                     Foreground="{DynamicResource BrushGlobalIcon}"
                                                                                     HorizontalAlignment="Center"
                                                                                     VerticalAlignment="Center"/>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsChecked" Value="True">
                                                                    <Setter TargetName="ExpanderGlyph" Property="Kind" Value="MinusBoxOutline"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </ToggleButton.Template>
                                                </ToggleButton>
                                                
                                                <!-- 内容区域 -->
                                                <Border x:Name="Bd" Grid.Column="1" Grid.Row="1"
                                                        Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter x:Name="PART_Header"
                                                                      ContentSource="Header"
                                                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                                                </Border>
                                                
                                                <!-- 子项容器 -->
                                                <ItemsPresenter x:Name="ItemsHost" Grid.Row="2" Grid.Column="1"/>
                                            </Grid>
                                            
                                            <ControlTemplate.Triggers>
                                                <DataTrigger Binding="{Binding ShowOnlineScoreSeparator}" Value="True">
                                                    <Setter TargetName="OnlineLibrarySeparator" Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                                <!-- 未展开时隐藏子项 -->
                                                <Trigger Property="IsExpanded" Value="False">
                                                    <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed"/>
                                                </Trigger>
                                                <Trigger Property="HasItems" Value="False">
                                                    <Setter TargetName="ExpanderColumn" Property="Width" Value="0"/>
                                                    <Setter TargetName="Expander" Property="Visibility" Value="Collapsed"/>
                                                </Trigger>
                                                <DataTrigger Binding="{Binding IsVirtualFolder}" Value="True">
                                                    <Setter TargetName="ExpanderColumn" Property="Width" Value="22"/>
                                                    <Setter TargetName="Expander" Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsVirtualFolder}" Value="False">
                                                    <Setter TargetName="ExpanderColumn" Property="Width" Value="0"/>
                                                    <Setter TargetName="Expander" Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushMenuHover}"/>
                                                    <Setter TargetName="Bd" Property="BorderThickness" Value="0"/>
                                                    <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                                                    <Trigger.EnterActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetName="Bd"
                                                                                 Storyboard.TargetProperty="Opacity"
                                                                                 From="0.82"
                                                                                 To="0.88"
                                                                                 Duration="0:0:0.12"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </Trigger.EnterActions>
                                                </Trigger>
                                                <!-- 选中状态 - 黄色高亮 -->
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#FFD54F"/>
                                                    <Setter Property="Foreground" Value="#212121"/>
                                                </Trigger>
                                                <!-- 非激活选中状态 - 浅黄色高亮 -->
                                                <MultiTrigger>
                                                    <MultiTrigger.Conditions>
                                                        <Condition Property="IsSelected" Value="True"/>
                                                        <Condition Property="IsSelectionActive" Value="False"/>
                                                    </MultiTrigger.Conditions>
                                                    <Setter TargetName="Bd" Property="Background" Value="#FFF59D"/>
                                                    <Setter Property="Foreground" Value="#424242"/>
                                                </MultiTrigger>
                                                <!-- 禁用状态 -->
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </TreeView.ItemContainerStyle>
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                <!-- 纵向布局：第一行是图标+文件名，第二行是文件夹标签 -->
                                <StackPanel Orientation="Vertical" Margin="0,2">
                                    <!-- 第一行：图标 + 文件/文件夹名称 -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Image Grid.Column="0"
                                               Source="{Binding IconImagePath, Converter={StaticResource ThumbnailPathToImageSourceConverter}}"
                                               Width="22"
                                               Height="22"
                                               Margin="0,0,10,0"
                                               VerticalAlignment="Center">
                                            <Image.Style>
                                                <Style TargetType="Image">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasIconImagePath}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Image.Style>
                                        </Image>

                                        <materialDesign:PackIcon Grid.Column="1"
                                                                Kind="{Binding IconKind}" 
                                                                Width="22" 
                                                                Height="22" 
                                                                Margin="0,0,10,0"
                                                                VerticalAlignment="Center">
                                            <materialDesign:PackIcon.Style>
                                                <Style TargetType="materialDesign:PackIcon">
                                                    <Setter Property="Foreground" Value="{DynamicResource BrushGlobalIcon}"/>
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding Type}" Value="Folder"/>
                                                                <Condition Binding="{Binding UseCustomIconColor}" Value="True"/>
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Foreground" Value="{Binding IconColor}"/>
                                                        </MultiDataTrigger>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding Type}" Value="LyricsGroup"/>
                                                                <Condition Binding="{Binding UseCustomIconColor}" Value="True"/>
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Foreground" Value="{Binding IconColor}"/>
                                                        </MultiDataTrigger>
                                                        <!-- 文件夹/歌词分组/歌词歌曲显示图标 -->
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding Type}" Value="Folder"/>
                                                                <Condition Binding="{Binding IsVirtualFolder}" Value="False"/>
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </MultiDataTrigger>
                                                        <DataTrigger Binding="{Binding Type}" Value="LyricsGroup">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Type}" Value="LyricsSong">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                        <!-- 如果没有IconKind也隐藏 -->
                                                        <DataTrigger Binding="{Binding IconKind}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IconKind}" Value="">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding HasIconImagePath}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </materialDesign:PackIcon.Style>
                                        </materialDesign:PackIcon>

                                        <!-- 文件/文件夹名称 - 支持内联编辑 -->
                                        <Grid Grid.Column="2">
                                            <!-- 显示模式：TextBlock -->
                                            <TextBlock Text="{Binding Name}" 
                                                       VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <!-- 默认使用文件字号 -->
                                                        <Setter Property="FontSize" Value="{Binding ElementName=MainWindowRoot, Path=FileFontSize}"/>
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <!-- 本地搜索结果保留用户字号，仅加粗强调，不改普通文件树/编辑框。 -->
                                                            <DataTrigger Binding="{Binding ShowFolderTag}" Value="True">
                                                                <Setter Property="FontWeight" Value="Bold"/>
                                                            </DataTrigger>
                                                            <!-- 如果是文件夹，使用文件夹字号 -->
                                                            <DataTrigger Binding="{Binding Type}" Value="Folder">
                                                                <Setter Property="FontSize" Value="{Binding ElementName=MainWindowRoot, Path=FolderFontSize}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsOnlineScoreLibraryRoot}" Value="True">
                                                                <Setter Property="Foreground" Value="#2A9D8F"/>
                                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Type}" Value="LyricsRoot">
                                                                <Setter Property="FontSize" Value="{Binding ElementName=MainWindowRoot, Path=FolderFontSize}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Type}" Value="LyricsGroup">
                                                                <Setter Property="FontSize" Value="{Binding ElementName=MainWindowRoot, Path=FolderFontSize}"/>
                                                            </DataTrigger>
                                                            <!-- 编辑模式时隐藏 -->
                                                            <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            
                                            <!-- 编辑模式：TextBox (无边框透明背景) -->
                                            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" 
                                                     VerticalAlignment="Center"
                                                     BorderThickness="0"
                                                     Background="Transparent"
                                                     Padding="0"
                                                     KeyDown="TreeItemEditBox_KeyDown"
                                                     LostFocus="TreeItemEditBox_LostFocus"
                                                     Loaded="TreeItemEditBox_Loaded"
                                                     IsVisibleChanged="TreeItemEditBox_IsVisibleChanged">
                                                <TextBox.Style>
                                                    <Style TargetType="TextBox">
                                                        <Setter Property="FontSize" Value="{Binding ElementName=MainWindowRoot, Path=FileFontSize}"/>
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Setter Property="CaretBrush" Value="Black"/>
                                                        <Style.Triggers>
                                                            <!-- 如果是文件夹，使用文件夹字号 -->
                                                            <DataTrigger Binding="{Binding Type}" Value="Folder">
                                                                <Setter Property="FontSize" Value="{Binding ElementName=MainWindowRoot, Path=FolderFontSize}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Type}" Value="LyricsRoot">
                                                                <Setter Property="FontSize" Value="{Binding ElementName=MainWindowRoot, Path=FolderFontSize}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Type}" Value="LyricsGroup">
                                                                <Setter Property="FontSize" Value="{Binding ElementName=MainWindowRoot, Path=FolderFontSize}"/>
                                                            </DataTrigger>
                                                            <!-- 编辑模式时显示 -->
                                                            <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBox.Style>
                                            </TextBox>
                                        </Grid>

                                    </Grid>

                                    <!-- 第二行：文件夹标签（搜索时显示，在名称下方）-->
                                    <Border Background="{Binding FolderColor}" 
                                            CornerRadius="3" 
                                            Padding="6,2" 
                                            Margin="26,2,0,0"
                                            HorizontalAlignment="Left">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ShowFolderTag}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding FolderName}" 
                                                   FontSize="{Binding ElementName=MainWindowRoot, Path=FolderTagFontSize}" 
                                                   Foreground="White"
                                                   FontWeight="SemiBold"/>
                                    </Border>
                                </StackPanel>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>

                    <GridSplitter x:Name="OnlineLibrarySplitter" Grid.Row="1" Height="5"
                                  HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                  ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"
                                  Background="#D7E5E2" Visibility="Collapsed" ShowsPreview="True"
                                  ToolTip="上下拖动，调整在线歌谱区域高度"
                                  DragCompleted="OnlineLibrarySplitter_DragCompleted"/>
                    <Grid x:Name="OnlineLibraryPane" Grid.Row="2" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="34"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Button x:Name="OnlineLibraryHeader" Height="34" Padding="10,0"
                                HorizontalContentAlignment="Stretch" BorderThickness="0"
                                Background="Transparent" Foreground="#2A9D8F"
                                Click="OnlineLibraryHeader_Click">
                            <Grid>
                                <TextBlock Text="在线歌谱" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <TextBlock x:Name="OnlineLibraryCollapseGlyph" Text="⌄" FontSize="18"
                                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                        </Button>
                        <TreeView x:Name="OnlineLibraryTree" Grid.Row="1"
                                  Style="{StaticResource ProjectTreeStyle}"
                                  ItemContainerStyle="{Binding ElementName=ProjectTree, Path=ItemContainerStyle}"
                                  ItemTemplate="{Binding ElementName=ProjectTree, Path=ItemTemplate}"
                                  VirtualizingPanel.IsVirtualizing="True"
                                  VirtualizingPanel.VirtualizationMode="Recycling"
                                  VirtualizingStackPanel.ScrollUnit="Pixel"
                                  ScrollViewer.CanContentScroll="True"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  PreviewKeyDown="Window_PreviewKeyDown"
                                  PreviewMouseLeftButtonDown="ProjectTree_PreviewFolderDoubleClick"
                                  PreviewMouseLeftButtonUp="ProjectTree_MouseClick"
                                  MouseDoubleClick="ProjectTree_MouseDoubleClick"
                                  PreviewMouseRightButtonDown="ProjectTree_RightClick"
                                  MouseMove="ProjectTree_MouseMove">
                            <TreeView.Resources>
                                <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource ProjectTreeScrollBarStyle}"/>
                            </TreeView.Resources>
                        </TreeView>
                    </Grid>
                    
                    <!-- 拖拽插入位置指示器 -->
                    <Canvas Grid.Row="0"
                            x:Name="DragIndicatorCanvas" 
                            IsHitTestVisible="False"
                            Background="Transparent">
                        <Line x:Name="DragIndicatorLine"
                              Stroke="#FF9800"
                              StrokeThickness="4"
                              X1="20" Y1="0" X2="200" Y2="0"
                              Visibility="Collapsed">
                            <Line.Effect>
                                <DropShadowEffect ShadowDepth="0" BlurRadius="3" Opacity="0.45" Color="#FF9800"/>
                            </Line.Effect>
                        </Line>
                    </Canvas>
                    
                    <!-- 文件名完整显示提示框 -->
                    <Popup x:Name="FileNameTooltipPopup"
                           AllowsTransparency="True"
                           Placement="Relative"
                           PlacementTarget="{Binding ElementName=ProjectTree}"
                           StaysOpen="True"
                           IsHitTestVisible="False">
                        <Border Background="#E0000000"
                                BorderBrush="#80FFFFFF"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="12,8"
                                MaxWidth="500">
                            <Border.Effect>
                                <DropShadowEffect ShadowDepth="2" 
                                                  BlurRadius="8" 
                                                  Opacity="0.5" 
                                                  Color="#000000"/>
                            </Border.Effect>
                            <TextBlock x:Name="FileNameTooltipText"
                                       Text=""
                                       Foreground="White"
                                       FontSize="14"
                                       FontWeight="Medium"
                                       TextWrapping="Wrap"/>
                        </Border>
                    </Popup>
                    </Grid>
                    
                    <!-- 屏幕选择器（底部） -->
                    <Border x:Name="ScreenSelectorPanel" Grid.Row="2" Background="#F5F5F5" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0" Padding="8">
                        <ComboBox x:Name="ScreenSelector" Height="32"
                                  SelectedIndex="0" FontSize="12"
                                  ToolTip="{Binding SelectedItem, RelativeSource={RelativeSource Self}}"
                                  Style="{StaticResource WhiteComboBoxPopup}"
                                  ItemContainerStyle="{StaticResource WhiteComboBoxItem}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" MaxWidth="480" ToolTip="{Binding}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </Border>
                </Grid>
            </Border>

            <!-- 分隔条 -->
            <GridSplitter x:Name="NavigationSplitter" 
                          Grid.Column="1" Grid.RowSpan="2" Width="3" HorizontalAlignment="Stretch"
                          Background="#E0E0E0" Cursor="SizeWE"
                          DragCompleted="NavigationSplitter_DragCompleted"/>

            <!-- 右侧：图片显示区 -->
            <Grid x:Name="ImageViewingSurface" Grid.Column="2" Background="{Binding ImageBackgroundBrush, RelativeSource={RelativeSource AncestorType={x:Type Window}}}">
                <!-- 结构谱悬浮工具栏：不占谱面高度，不进入投影；移入图片区显示，移出隐藏。 -->
                <Border x:Name="StructuredScoreBar" Tag="False" Panel.ZIndex="300"
                        HorizontalAlignment="Center" VerticalAlignment="Top" Margin="12,14,12,0"
                        Background="{DynamicResource BrushMediaDialogSurface}" BorderBrush="{DynamicResource BrushMediaDialogBorder}" BorderThickness="1" CornerRadius="10" Padding="6"
                        TextElement.Foreground="{DynamicResource BrushMediaDialogText}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True"/>
                                        <Condition Binding="{Binding ElementName=ImageViewingSurface, Path=IsMouseOver}" Value="True"/>
                                        <Condition Binding="{Binding ElementName=ImageScrollViewer, Path=IsVisible}" Value="True"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible"/>
                                </MultiDataTrigger>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True"/>
                                        <Condition Binding="{Binding ElementName=StructuredScorePinButton, Path=IsChecked}" Value="True"/>
                                        <Condition Binding="{Binding ElementName=ImageScrollViewer, Path=IsVisible}" Value="True"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Border.Resources>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="{DynamicResource BrushMediaDialogText}"/>
                            <Setter Property="FontSize" Value="13"/>
                            <Setter Property="Padding" Value="10,6"/>
                            <Setter Property="MinHeight" Value="32"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Setter Property="BorderBrush" Value="Transparent"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="0.8"/></Trigger>
                                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource BrushMediaDialogSelected}"/></Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource BrushMediaDialogOutline}"/></Trigger>
                                <Trigger Property="Selector.IsSelected" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource BrushMediaDialogAccent}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource BrushMediaDialogOnAccent}"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource BrushMediaDialogOutline}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/></Trigger>
                            </Style.Triggers>
                        </Style>
                        <Style x:Key="StructuredScorePageNumberButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                            <Setter Property="Background" Value="{DynamicResource BrushMediaDialogSelected}"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource BrushMediaDialogBorder}"/>
                        </Style>
                    </Border.Resources>
                    <!-- 随页码自然加宽；窗口不足时横向滚动，按钮和页码均不换行。 -->
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" CanContentScroll="False">
                    <StackPanel>
                    <StackPanel x:Name="StructuredScoreMainActions" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Button x:Name="StructuredScorePaginatedButton" Content="分页" Tag="0" Padding="10,4" Click="StructuredScoreLayout_Click"/>
                        <Button x:Name="StructuredScoreLongButton" Content="长页" Tag="2" Padding="10,4" Margin="4,0" Click="StructuredScoreLayout_Click"/>
                        <Button x:Name="StructuredScoreCombinedButton" Content="合页" Tag="1" IsEnabled="False" Padding="10,4" Click="StructuredScoreLayout_Click"/>
                        <Button x:Name="StructuredScoreLyricsButton" Content="歌词" ToolTip="进入当前歌谱的歌词" Margin="4,0,0,0" Padding="10,4" Click="StructuredScoreLyrics_Click"/>
                        <Button Content="编辑谱文" Margin="8,0,0,0" Padding="6,2" Click="StructuredScoreEdit_Click"/>
                        <Button x:Name="StructuredScoreImageButton" Content="显示图片" Visibility="Collapsed" ToolTip="下载诗歌本提供的图片兜底，谱码保留；再次点击返回谱码" Margin="4,0,0,0" Padding="8,4" Click="StructuredScoreImage_Click"/>
                        <ToggleButton x:Name="StructuredScorePinButton" ToolTip="固定工具栏：点亮常显，关闭后移出隐藏" AutomationProperties.Name="固定歌谱工具栏"
                                      Click="StructuredScorePin_Click" Margin="6,0,0,0" Padding="8,4" MinWidth="32" MinHeight="32" Cursor="Hand">
                            <ToggleButton.Style>
                                <Style TargetType="ToggleButton">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Foreground" Value="{DynamicResource BrushMediaDialogMuted}"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Setter Property="BorderBrush" Value="Transparent"/>
                                    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource BrushMediaDialogSelected}"/></Trigger>
                                            <Trigger Property="IsChecked" Value="True"><Setter Property="Background" Value="{DynamicResource BrushMediaDialogAccent}"/><Setter Property="Foreground" Value="{DynamicResource BrushMediaDialogOnAccent}"/><Setter Property="BorderBrush" Value="{DynamicResource BrushMediaDialogOutline}"/></Trigger>
                                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="0.8"/></Trigger>
                                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource BrushMediaDialogOutline}"/></Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate></Setter.Value></Setter>
                                </Style>
                            </ToggleButton.Style>
                                    <Path Data="{StaticResource IconLucidePin}" Style="{StaticResource LucideIconPathStyle}" Width="14" Height="14"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type ToggleButton}}}"/>
                        </ToggleButton>
                    </StackPanel>
                    <TextBlock x:Name="StructuredScorePageText" Visibility="Collapsed"/>
                    <Grid x:Name="StructuredScorePageNavigation" HorizontalAlignment="Center" Margin="0,4,0,0" Visibility="Collapsed">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Button x:Name="StructuredScorePreviousButton" Grid.Column="0" VerticalAlignment="Top" ToolTip="上一页" AutomationProperties.Name="上一页"
                                Padding="6,4" MinWidth="28" Click="StructuredScorePrevious_Click">
                            <Path Data="{StaticResource IconLucideChevronLeft}" Style="{StaticResource LucideIconPathStyle}" Width="14" Height="14"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"/>
                        </Button>
                        <StackPanel x:Name="StructuredScorePageNumbers" Orientation="Horizontal" Grid.Column="1" HorizontalAlignment="Center" Visibility="Collapsed"
                                   AutomationProperties.Name="歌谱页码"/>
                        <Button x:Name="StructuredScoreNextButton" Grid.Column="2" VerticalAlignment="Bottom" ToolTip="下一页" AutomationProperties.Name="下一页"
                                Padding="6,4" MinWidth="28" Click="StructuredScoreNext_Click">
                            <Path Data="{StaticResource IconLucideChevronRight}" Style="{StaticResource LucideIconPathStyle}" Width="14" Height="14"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"/>
                        </Button>
                    </Grid>
                    </StackPanel>
                    </ScrollViewer>
                </Border>
                <!-- 图片显示区域（支持滚动和缩放） -->
                <ScrollViewer x:Name="ImageScrollViewer"
                     HorizontalScrollBarVisibility="Disabled"
                     VerticalScrollBarVisibility="Auto"
                     Background="{Binding ImageBackgroundBrush, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                     BorderThickness="0"
                     PreviewMouseWheel="ImageScrollViewer_PreviewMouseWheel"
                     IsVisibleChanged="ImageZoomSurface_IsVisibleChanged"
                     SizeChanged="ImageScrollViewer_SizeChanged"
                     MouseRightButtonUp="ImageScrollViewer_RightClick"
                     PreviewMouseDown="ImageArea_PreviewMouseDown">
                    <ScrollViewer.Resources>
                        <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource FixedScrollBarStyle}"/>
                    </ScrollViewer.Resources>
                    <ScrollViewer.ContextMenu>
                        <ContextMenu x:Name="CanvasContextMenu" Style="{StaticResource NoBorderContextMenuStyle}" Opened="CanvasContextMenu_Opened">
                            <MenuItem Header="滚动速度">
                                <MenuItem Header="0秒 (直接跳转)" Click="SetScrollSpeed_Click" Tag="0" IsCheckable="True"/>
                                <MenuItem Header="0.5秒" Click="SetScrollSpeed_Click" Tag="0.5" IsCheckable="True"/>
                                <MenuItem Header="1.0秒" Click="SetScrollSpeed_Click" Tag="1.0" IsCheckable="True"/>
                                <MenuItem Header="8.0秒" Click="SetScrollSpeed_Click" Tag="8.0" IsCheckable="True" IsChecked="True"/>
                                <MenuItem Header="9.0秒" Click="SetScrollSpeed_Click" Tag="9.0" IsCheckable="True"/>
                                <MenuItem Header="10.0秒" Click="SetScrollSpeed_Click" Tag="10.0" IsCheckable="True"/>
                                <MenuItem Header="11.0秒" Click="SetScrollSpeed_Click" Tag="11.0" IsCheckable="True"/>
                                <MenuItem Header="12.0秒" Click="SetScrollSpeed_Click" Tag="12.0" IsCheckable="True"/>
                                <MenuItem Header="13.0秒" Click="SetScrollSpeed_Click" Tag="13.0" IsCheckable="True"/>
                                <MenuItem Header="14.0秒" Click="SetScrollSpeed_Click" Tag="14.0" IsCheckable="True"/>
                                <MenuItem Header="15.0秒" Click="SetScrollSpeed_Click" Tag="15.0" IsCheckable="True"/>
                            </MenuItem>
                            <MenuItem Header="滚动函数">
                                <MenuItem Header="贝塞尔曲线" Click="SetScrollEasing_Click" Tag="Bezier" IsCheckable="True"/>
                                <MenuItem Header="CSS缓入缓出" Click="SetScrollEasing_Click" Tag="CssEaseInOut" IsCheckable="True"/>
                                <MenuItem Header="超级平滑" Click="SetScrollEasing_Click" Tag="UltraSmooth" IsCheckable="True"/>
                                <MenuItem Header="线性滚动" Click="SetScrollEasing_Click" Tag="Linear" IsCheckable="True" IsChecked="True"/>
                            </MenuItem>
                        </ContextMenu>
                    </ScrollViewer.ContextMenu>
                    <Grid x:Name="ImageContainer" Background="{Binding ImageBackgroundBrush, RelativeSource={RelativeSource AncestorType={x:Type Window}}}">
                        <Image x:Name="ImageDisplay" 
                               Stretch="Fill"
                               HorizontalAlignment="Stretch"
                               VerticalAlignment="Top"
                               MouseLeftButtonDown="ImageDisplay_MouseLeftButtonDown"
                               MouseLeftButtonUp="ImageDisplay_MouseLeftButtonUp"
                               MouseMove="ImageDisplay_MouseMove"
                               MouseDown="ImageDisplay_MouseDown"
                               PreviewMouseDown="ImageDisplay_PreviewMouseDown"
                               Cursor="Hand">
                            <Image.LayoutTransform>
                                <ScaleTransform x:Name="ImageScaleTransform" ScaleX="1" ScaleY="1"/>
                            </Image.LayoutTransform>
                        </Image>

                        <!-- 关键帧预览线容器 - 直接叠加在图片上 -->
                        <Canvas x:Name="KeyframePreviewLinesCanvas"
                                IsHitTestVisible="False"
                                Background="Transparent"
                                Panel.ZIndex="10"/>
                    </Grid>
                </ScrollViewer>

                <!-- 图片缩放按钮：固定在图片显示区域底部居中，不随图片内容滚动 -->
                <Border x:Name="ImageZoomControlsPanel"
                        Visibility="Collapsed"
                        Panel.ZIndex="300"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Bottom"
                        Margin="0,0,0,18"
                        Padding="6,4"
                        Background="#CC222222"
                        BorderBrush="#66808080"
                        BorderThickness="1"
                        CornerRadius="8">
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="BtnImageZoomOut"
                                Style="{StaticResource MenuButtonStyle}"
                                Width="46" MinWidth="46" Height="40"
                                Margin="0" Padding="0"
                                Background="Transparent" BorderBrush="Transparent"
                                ToolTip="缩小图片" Click="BtnImageZoomOut_Click">
                            <Path Data="{StaticResource IconLucideMinus}"
                                  Style="{StaticResource LucideIconPathStyle}"
                                  Stroke="White" Width="20" Height="20"/>
                        </Button>
                        <Border x:Name="ImageZoomWheelHint"
                                Width="50" Height="40"
                                Background="Transparent"
                                Cursor="SizeNS"
                                ToolTip="滚轮缩放图片"
                                PreviewMouseWheel="ImageZoomWheelHint_PreviewMouseWheel">
                            <Path Data="{StaticResource IconLucideMouseWheel}"
                                  Style="{StaticResource LucideIconPathStyle}"
                                  Stroke="#D9FFFFFF" Width="20" Height="20"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Button x:Name="BtnImageZoomIn"
                                Style="{StaticResource MenuButtonStyle}"
                                Width="46" MinWidth="46" Height="40"
                                Margin="0" Padding="0"
                                Background="Transparent" BorderBrush="Transparent"
                                ToolTip="放大图片" Click="BtnImageZoomIn_Click">
                            <Path Data="{StaticResource IconLucidePlus}"
                                  Style="{StaticResource LucideIconPathStyle}"
                                  Stroke="White" Width="20" Height="20"/>
                        </Button>
                    </StackPanel>
                </Border>
                
                <!-- 视频播放区域（默认隐藏，播放视频时显示） -->
                <Grid x:Name="VideoContainer"
                      Background="#000000"
                      Visibility="Collapsed"
                      IsVisibleChanged="ImageZoomSurface_IsVisibleChanged"
                      MouseRightButtonUp="VideoContainer_RightClick">
                    <!-- VideoView控件将在代码中动态添加 -->
                    
                    <!-- 媒体文件名称显示（用于纯音频文件，铺满整个区域） -->
                    <Grid x:Name="MediaFileNameBorder" 
                          Background="#000000"
                          Visibility="Collapsed">
                        <!-- 文件名内容，居中显示 -->
                        <StackPanel VerticalAlignment="Center" 
                                    HorizontalAlignment="Center">
                            <Viewbox Width="80"
                                     Height="80"
                                     HorizontalAlignment="Center"
                                     Margin="0,0,0,20">
                                <Path Data="{StaticResource IconLucideMusic}"
                                      Style="{StaticResource LucideIconPathStyle}"
                                      Stroke="White"/>
                            </Viewbox>
                            <TextBlock x:Name="MediaFileNameText"
                                       Text="媒体文件"
                                       FontSize="28"
                                       FontWeight="Medium"
                                       Foreground="White"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       HorizontalAlignment="Center"
                                       MaxWidth="800"
                                       Padding="20,0"/>
                        </StackPanel>
                    </Grid>

                </Grid>

                <!--  圣经显示区域（默认隐藏，切换到圣经模式时显示） -->
                <!-- 注意：圣经模式下，左侧ProjectTree会被替换为圣经专用导航 -->
                <views:BibleSectionView x:Name="BibleSectionView"/>

                <!--  文本编辑器面板（默认隐藏，类似PPT的布局） -->
                <views:TextEditorSectionView x:Name="TextEditorSectionView"/>

                <!--  歌词编辑器面板（极简黑色版） -->
                <views:LyricsSectionView x:Name="LyricsSectionView"/>

                <!-- 关键帧位置提示区域 - 灰色条（叠加在ScrollViewer上方） -->
                <Border x:Name="ScrollbarIndicatorsBorder"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Stretch"
                        Width="18.5"
                        Margin="0,0,24,0"
                        Background="Transparent"
                        Panel.ZIndex="200">
                    <Canvas x:Name="ScrollbarIndicatorsCanvas"
                            Background="Transparent"
                            MouseLeftButtonDown="ScrollbarIndicatorsCanvas_Click"
                            MouseRightButtonDown="ScrollbarIndicatorsCanvas_Click"
                            ToolTip="左键：跳转到关键帧  |  右键：设置循环次数"/>
                </Border>
                <!--  浮动合成播放按钮组（左上角） -->
                <StackPanel x:Name="CompositePlaybackPanel"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Margin="15,45,0,0"
                            Orientation="Vertical"
                            Panel.ZIndex="300"
                            Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="BtnFloatingCompositePlay"
                                Padding="15,8"
                                FontSize="18"
                                FontWeight="SemiBold"
                                Background="{StaticResource BrushBrandPrimary}"
                                Foreground="White"
                                BorderBrush="{StaticResource BrushBrandPrimary}"
                                BorderThickness="0"
                                Cursor="Hand"
                                Opacity="0.75"
                                Click="BtnCompositePlay_Click"
                                MouseRightButtonUp="BtnCompositePlay_RightClick"
                                ToolTip="左键：开始/停止播放 | 右键：快捷设置时长">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconLucideClapperboard}"
                                      Style="{StaticResource LucideIconPathStyle}"
                                      Stroke="White"
                                      Margin="0,0,8,0"/>
                                <TextBlock Text="合成播放" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="border" 
                                                        Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="20"
                                                        Padding="{TemplateBinding Padding}">
                                                    <Border.Effect>
                                                        <DropShadowEffect ShadowDepth="2" BlurRadius="8" Opacity="0.3" Color="Black"/>
                                                    </Border.Effect>
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="border" Property="Background" Value="#1976D2"/>
                                                        <Setter Property="Opacity" Value="1.0"/>
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter TargetName="border" Property="Background" Value="#0D47A1"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                        <!--  暂停/继续按钮（仅在合成播放时显示） -->
                        <Button x:Name="BtnCompositePause"
                                Padding="15,8"
                                Margin="8,0,0,0"
                                FontSize="18"
                                FontWeight="SemiBold"
                                Background="{StaticResource BrushBrandPrimary}"
                                Foreground="White"
                                BorderBrush="{StaticResource BrushBrandPrimary}"
                                BorderThickness="0"
                                Cursor="Hand"
                                Opacity="0.75"
                                Visibility="Collapsed"
                                Click="BtnCompositePause_Click"
                                ToolTip="暂停/继续（与 F2 一致）">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconLucidePause}"
                                      Style="{StaticResource LucideIconPathStyle}"
                                      Stroke="White"
                                      Margin="0,0,6,0"/>
                                <TextBlock Text="暂停" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="border" 
                                                        Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="20"
                                                        Padding="{TemplateBinding Padding}">
                                                    <Border.Effect>
                                                        <DropShadowEffect ShadowDepth="2" BlurRadius="8" Opacity="0.3" Color="Black"/>
                                                    </Border.Effect>
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="border" Property="Background" Value="#1976D2"/>
                                                        <Setter Property="Opacity" Value="1.0"/>
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter TargetName="border" Property="Background" Value="#0D47A1"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                    <!--  速度选项（仅在播放时显示） -->
                    <UniformGrid x:Name="CompositeSpeedOptionsPanel"
                                 Rows="2"
                                 Columns="4"
                                 Margin="0,8,0,0"
                                 Visibility="Collapsed"
                                 HorizontalAlignment="Center">
                        <UniformGrid.Resources>
                            <Style x:Key="CompositeSpeedOptionButtonStyle" TargetType="Button">
                                <Setter Property="MinWidth" Value="42"/>
                                <Setter Property="Height" Value="28"/>
                                <Setter Property="Margin" Value="2,2"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="FontSize" Value="13"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="Background" Value="#455A64"/>
                                <Setter Property="BorderBrush" Value="#607D8B"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Setter Property="Opacity" Value="0.82"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="speedOptionBorder"
                                                    Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="4">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="speedOptionBorder" Property="Background" Value="#546E7A"/>
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="speedOptionBorder" Property="Background" Value="#37474F"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </UniformGrid.Resources>
                        <Button Content="0.5" Tag="0.50" Click="CompositeSpeedOption_Click" Style="{StaticResource CompositeSpeedOptionButtonStyle}"/>
                        <Button Content="0.75" Tag="0.75" Click="CompositeSpeedOption_Click" Style="{StaticResource CompositeSpeedOptionButtonStyle}"/>
                        <Button Content="1.0" Tag="1.00" Click="CompositeSpeedOption_Click" Style="{StaticResource CompositeSpeedOptionButtonStyle}"/>
                        <Button Content="1.25" Tag="1.25" Click="CompositeSpeedOption_Click" Style="{StaticResource CompositeSpeedOptionButtonStyle}"/>
                        <Button Content="1.5" Tag="1.50" Click="CompositeSpeedOption_Click" Style="{StaticResource CompositeSpeedOptionButtonStyle}"/>
                        <Button Content="2.0" Tag="2.00" Click="CompositeSpeedOption_Click" Style="{StaticResource CompositeSpeedOptionButtonStyle}"/>
                        <Button Content="2.5" Tag="2.50" Click="CompositeSpeedOption_Click" Style="{StaticResource CompositeSpeedOptionButtonStyle}"/>
                        <Button Content="3.0" Tag="3.00" Click="CompositeSpeedOption_Click" Style="{StaticResource CompositeSpeedOptionButtonStyle}"/>
                    </UniformGrid>
                </StackPanel>

            </Grid>

            <!-- 媒体控制栏仅占右侧列，不进入VideoView，也不挤压左侧目录与屏幕选择器 -->
            <views:MediaPlayerSectionView x:Name="MediaPlayerSectionView"
                                          Grid.Row="1"
                                          Grid.Column="2"/>
        </Grid>


        <!-- ========== Toast 通知容器（悬浮提示，显示在合成播放按钮下方） ========== -->
        <Border x:Name="ToastNotification" 
                Grid.RowSpan="2"
                Background="#CC000000"
                CornerRadius="8"
                Padding="20,12"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,110,50,0"
                Visibility="Collapsed"
                Panel.ZIndex="9999"
                IsHitTestVisible="False">
            <Border.Effect>
                <DropShadowEffect ShadowDepth="3" BlurRadius="10" Opacity="0.5"/>
            </Border.Effect>
            <TextBlock x:Name="ToastMessage" 
                       FontSize="14"
                       FontWeight="Medium"
                       Foreground="White"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       MaxWidth="200"/>
        </Border>
    </Grid>
</Window>
