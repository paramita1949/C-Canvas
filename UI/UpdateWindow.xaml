<Window x:Class="ImageColorChanger.UI.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="软件更新" Height="620" Width="780" MinHeight="420" MinWidth="620"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="White" FontFamily="Microsoft YaHei UI"
        AllowsTransparency="False" WindowStyle="None">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="7"
                           CornerRadius="10" GlassFrameThickness="0"/>
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="MinWidth" Value="90"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Background" Value="{StaticResource BrushDialogBrandPrimary}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource BrushDialogBrandHover}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#C7CAD1"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TextAction" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#747782"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#F2F3F5"/>
                                <Setter Property="Foreground" Value="#30323A"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border Background="White" CornerRadius="10" BorderBrush="#E6E7EB" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <!-- 白色单行版本栏，空白处可拖动、双击可最大化。 -->
            <Border x:Name="HeaderBar" Grid.Row="0" Background="White" CornerRadius="10,10,0,0"
                    Padding="20,12" BorderBrush="#ECEEF2" BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="HeaderTitleText" FontSize="15" FontWeight="SemiBold"
                               Foreground="#24262D" VerticalAlignment="Center"/>
                    <TextBlock x:Name="VersionText" Grid.Column="1" FontSize="14"
                               Foreground="#92959E" Margin="20,0,12,0" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>
                    <Button x:Name="CloseButton" Grid.Column="2" Width="30" Padding="0"
                            Style="{StaticResource TextAction}" ToolTip="关闭" AutomationProperties.Name="关闭"
                            Click="CloseButton_Click">
                        <Path Data="M4 4L16 16 M4 16L16 4" Stroke="#8C909A" StrokeThickness="1.5"
                              Width="12" Height="12" Stretch="Uniform"/>
                    </Button>
                </Grid>
            </Border>
            <!-- 直接显示正文，不添加介绍、卡片或重复小节标题。 -->
            <Grid x:Name="InfoPanel" Grid.Row="1" Margin="20,18,12,18">
                <TextBox x:Name="ReleaseNotesText" FontSize="15" TextBlock.LineHeight="26"
                         Padding="0,0,8,0" IsReadOnly="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                         BorderThickness="0" Background="Transparent" Foreground="#50535E">
                    <TextBox.Resources>
                        <Style TargetType="ScrollBar" BasedOn="{StaticResource CompactScrollBarStyleLight}"/>
                    </TextBox.Resources>
                </TextBox>
            </Grid>
            <Border x:Name="ProgressPanel" Grid.Row="2" Margin="20,0,20,12" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock x:Name="ProgressText" FontSize="13" Foreground="#50535E"
                               TextWrapping="Wrap" Margin="0,0,0,6"/>
                    <ProgressBar x:Name="DownloadProgress" Height="5" Minimum="0" Maximum="100"
                                 Background="#ECEEF2" Foreground="{StaticResource BrushDialogBrandPrimary}" Margin="0,0,0,6"/>
                    <TextBlock x:Name="ProgressDetailText" FontSize="12" Foreground="#92959E" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
            <Border Grid.Row="3" Background="White" CornerRadius="0,0,10,10" Padding="12,10"
                    BorderBrush="#ECEEF2" BorderThickness="0,1,0,0">
                <Grid>
                    <Button x:Name="BrowserDownloadButton" Content="浏览器下载" HorizontalAlignment="Left"
                            Style="{StaticResource TextAction}" Click="BrowserDownloadButton_Click"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="SkipButton" Style="{StaticResource TextAction}" Click="SkipButton_Click">
                            <TextBlock x:Name="SkipButtonText" Text="稍后"/>
                        </Button>
                        <Button x:Name="UpdateButton" Style="{StaticResource PrimaryButton}" Click="UpdateButton_Click">
                            <TextBlock x:Name="UpdateButtonText" Text="立即更新"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
            <ResizeGrip Grid.Row="3" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,2,2"/>
        </Grid>
    </Border>
</Window>
