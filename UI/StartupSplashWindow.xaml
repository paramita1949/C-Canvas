<Window x:Class="ImageColorChanger.UI.StartupSplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="咏慕投影"
        Width="948"
        Height="415"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        Topmost="True"
        AllowsTransparency="True"
        Background="Transparent"
        SnapsToDevicePixels="True">
    <Grid>
        <Border CornerRadius="8"
                BorderBrush="#26385460"
                BorderThickness="1"
                ClipToBounds="True">
            <Grid>
                <Image x:Name="SplashImage"
                       Stretch="UniformToFill"
                       SnapsToDevicePixels="True" />

                <StackPanel x:Name="CenterScripturePanel"
                            Width="720"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Bottom"
                            Margin="0,0,0,78">
                    <TextBlock x:Name="CenterScriptureText"
                               Text="你们要以感恩为祭献与神，又要向至高者还你的愿。"
                               HorizontalAlignment="Center"
                               FontSize="17"
                               FontWeight="SemiBold"
                               Foreground="#1E6A9A"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               TextTrimming="CharacterEllipsis"
                               LineHeight="25"
                               MaxHeight="52" />
                    <TextBlock x:Name="CenterScriptureReferenceText"
                               Text="—— 诗 50:14 ——"
                               HorizontalAlignment="Center"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="#1E6A9A"
                               Opacity="0.92"
                               TextAlignment="Center"
                               Margin="0,7,0,0" />
                </StackPanel>

                <Border x:Name="SplashFooter"
                        VerticalAlignment="Bottom"
                        MinHeight="54"
                        Padding="18,0,18,11">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#00305468" Offset="0" />
                            <GradientStop Color="#78305468" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid VerticalAlignment="Bottom">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <Image Width="28"
                                   Height="28"
                                   Source="pack://application:,,,/baodian.ico"
                                   Stretch="Uniform"
                                   Margin="0,0,9,0" />
                            <TextBlock Text="咏慕投影"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="White"
                                       VerticalAlignment="Center" />
                        </StackPanel>

                        <TextBlock x:Name="StatusText"
                                   Grid.Column="1"
                                   Text="正在启动..."
                                   FontSize="12"
                                   Foreground="#F0FFFFFF"
                                   VerticalAlignment="Center"
                                   TextAlignment="Right"
                                   Margin="18,0,0,0" />
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
