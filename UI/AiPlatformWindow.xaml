<Window x:Class="ImageColorChanger.UI.AiPlatformWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI平台" Width="980" Height="720" MinWidth="760" MinHeight="620"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize" Background="#EEF3F8" FontFamily="Microsoft YaHei UI">
    <Window.Resources>
        <Style x:Key="PrimaryButtonStyle" TargetType="Button"><Setter Property="Height" Value="36"/><Setter Property="MinWidth" Value="116"/><Setter Property="Padding" Value="16,0"/><Setter Property="Background" Value="#1D6FE8"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#1D6FE8"/><Setter Property="BorderThickness" Value="1"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="FontSize" Value="14"/><Setter Property="Cursor" Value="Hand"/></Style>
        <Style x:Key="SecondaryButtonStyle" TargetType="Button"><Setter Property="Height" Value="36"/><Setter Property="MinWidth" Value="96"/><Setter Property="Padding" Value="14,0"/><Setter Property="Background" Value="#F1F6FB"/><Setter Property="Foreground" Value="#31546F"/><Setter Property="BorderBrush" Value="#BFD1E3"/><Setter Property="BorderThickness" Value="1"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="FontSize" Value="13"/><Setter Property="Cursor" Value="Hand"/></Style>
        <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}"><Setter Property="Foreground" Value="#B23A4A"/><Setter Property="BorderBrush" Value="#E5B6BE"/><Setter Property="Background" Value="#FFF5F6"/></Style>
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock"><Setter Property="Foreground" Value="#19365B"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="FontSize" Value="14"/><Setter Property="Margin" Value="0,0,0,7"/></Style>
        <Style x:Key="InputStyle" TargetType="Control"><Setter Property="Height" Value="38"/><Setter Property="BorderBrush" Value="#BED0E6"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Background" Value="#FDFEFF"/><Setter Property="FontSize" Value="14"/><Setter Property="Padding" Value="10,0"/></Style><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,8"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="ItemRoot" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="12" Padding="10"><ContentPresenter HorizontalAlignment="Stretch"/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemRoot" Property="Background" Value="#E5F1FF"/><Setter TargetName="ItemRoot" Property="BorderBrush" Value="#7EB7EE"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ItemRoot" Property="Background" Value="#EFF7FF"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
            <Style x:Key="DropDownItemStyle" TargetType="ComboBoxItem"><Setter Property="MinHeight" Value="36"/><Setter Property="Padding" Value="10,7"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="ItemBorder" Background="Transparent" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter VerticalAlignment="Center" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}" ContentStringFormat="{TemplateBinding ContentStringFormat}"/></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="#EAF3FF"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="#DCEBFF"/><Setter Property="Foreground" Value="#1558A6"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.55"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
        <Style x:Key="DropDownScrollBarStyle" TargetType="ScrollBar"><Setter Property="Width" Value="10"/><Setter Property="Background" Value="Transparent"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Grid Background="Transparent" Margin="0,2"><Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="Vertical" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}" ViewportSize="{TemplateBinding ViewportSize}"><Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border x:Name="ThumbBorder" Background="#AFC3DA" CornerRadius="5" Margin="1,2"><Border.Style><Style TargetType="Border"><Setter Property="Opacity" Value="0.9"/><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#7198C1"/><Setter Property="Opacity" Value="1"/></Trigger></Style.Triggers></Style></Border.Style></Border></ControlTemplate></Thumb.Template></Thumb></Track.Thumb><Track.DecreaseRepeatButton><RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Visibility="Collapsed"/></Track.DecreaseRepeatButton><Track.IncreaseRepeatButton><RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Visibility="Collapsed"/></Track.IncreaseRepeatButton></Track></Grid></ControlTemplate></Setter.Value></Setter></Style>
        <Style x:Key="DropDownComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource InputStyle}"><Setter Property="MaxDropDownHeight" Value="280"/><Setter Property="ItemContainerStyle" Value="{StaticResource DropDownItemStyle}"/><Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/><Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/><Setter Property="Padding" Value="10,0"/><Style.Resources><Style TargetType="ScrollBar" BasedOn="{StaticResource DropDownScrollBarStyle}"/></Style.Resources></Style>    </Window.Resources>
    <Grid Margin="16">
        <Grid.ColumnDefinitions><ColumnDefinition Width="240"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="#F3F8FC" BorderBrush="#D7E3EF" BorderThickness="1" CornerRadius="14" Padding="14" Margin="0,0,12,0"><DockPanel>
                <StackPanel DockPanel.Dock="Bottom"><Button x:Name="AddProfileButton" Content="＋ 添加配置" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Stretch" Click="AddProfileButton_Click"/></StackPanel>
                <StackPanel><TextBlock Text="我的配置" Foreground="#6F8499" FontSize="12" FontWeight="Bold" Margin="8,3,8,12"/><ListBox x:Name="ProfileListBox" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch" SelectionChanged="ProfileListBox_SelectionChanged"><ListBox.ItemTemplate><DataTemplate><Grid HorizontalAlignment="Stretch"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Grid.Column="0" Margin="0,0,6,0"><StackPanel Orientation="Horizontal"><TextBlock Text="●" Foreground="#1BA66A" FontSize="12" Margin="0,0,7,0"/><TextBlock Text="{Binding DisplayName}" Foreground="#153653" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/></StackPanel><TextBlock Text="{Binding Summary}" Foreground="#6C8299" FontSize="12" Margin="18,7,0,0" TextWrapping="Wrap"/></StackPanel><Button x:Name="DeleteProfileButton" Grid.Column="1" Tag="{Binding Id}" Content="×" Width="28" Height="28" MinWidth="0" Padding="0" VerticalAlignment="Top" ToolTip="删除此配置" IsEnabled="{Binding CanDelete}" Style="{StaticResource DangerButtonStyle}" Click="DeleteProfileButton_Click"/></Grid></DataTemplate></ListBox.ItemTemplate></ListBox></StackPanel>
            </DockPanel></Border>
            <Border Grid.Column="1" Background="#FFFFFF" BorderBrush="#D7E3EF" BorderThickness="1" CornerRadius="14" Padding="24"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ScrollViewer.Resources><Style TargetType="ScrollBar" BasedOn="{StaticResource DropDownScrollBarStyle}"/></ScrollViewer.Resources><StackPanel>
                <Grid Margin="0,0,0,20"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="配置名称" FontSize="12" FontWeight="SemiBold" Foreground="#6C8299" Margin="0,0,0,6"/><TextBox x:Name="ProfileNameTextBox" Text="AI 主配置" Style="{StaticResource InputStyle}" FontSize="19" FontWeight="Bold" Foreground="#153653" VerticalContentAlignment="Center" TextChanged="ProfileNameTextBox_TextChanged"/></StackPanel><Border Grid.Column="1" Background="#E1F7ED" CornerRadius="999" Padding="10,7" VerticalAlignment="Top" Margin="12,0,0,0"><TextBlock x:Name="DetailStatusText" Text="● 已启用" Foreground="#118255" FontSize="12" FontWeight="Bold"/></Border></Grid>

                <ComboBox x:Name="ProviderComboBox" Style="{StaticResource DropDownComboBoxStyle}" VerticalContentAlignment="Center" SelectionChanged="ProviderComboBox_SelectionChanged"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding DisplayName}" Foreground="#153653" FontSize="14" TextTrimming="CharacterEllipsis"/></DataTemplate></ComboBox.ItemTemplate><ComboBox.GroupStyle><GroupStyle><GroupStyle.HeaderTemplate><DataTemplate><TextBlock Text="{Binding Name}" Foreground="#6A7E95" FontWeight="SemiBold" FontSize="12" Margin="4,8,4,4"/></DataTemplate></GroupStyle.HeaderTemplate></GroupStyle></ComboBox.GroupStyle></ComboBox>
                <TextBlock Text="协议" Style="{StaticResource FieldLabelStyle}" Margin="0,18,0,7"/><ComboBox x:Name="ProtocolComboBox" Style="{StaticResource DropDownComboBoxStyle}" VerticalContentAlignment="Center" SelectionChanged="ProtocolComboBox_SelectionChanged"/>
                <TextBlock Text="模型目录 Base URL" Style="{StaticResource FieldLabelStyle}" Margin="0,18,0,7"/><TextBox x:Name="BaseUrlTextBox" Style="{StaticResource InputStyle}" VerticalContentAlignment="Center" TextChanged="BaseUrlTextBox_TextChanged"/>
                <TextBlock Text="Chat Completions 地址" Style="{StaticResource FieldLabelStyle}" Margin="0,18,0,7"/><TextBox x:Name="ChatCompletionsEndpointTextBox" Style="{StaticResource InputStyle}" VerticalContentAlignment="Center" TextChanged="EndpointTextBox_TextChanged"/>
                <TextBlock Text="Responses 地址" Style="{StaticResource FieldLabelStyle}" Margin="0,18,0,7"/><TextBox x:Name="ResponsesEndpointTextBox" Style="{StaticResource InputStyle}" VerticalContentAlignment="Center" TextChanged="EndpointTextBox_TextChanged"/>
                <TextBlock Text="API Key" Style="{StaticResource FieldLabelStyle}" Margin="0,18,0,7"/><PasswordBox x:Name="ApiKeyBox" Style="{StaticResource InputStyle}" VerticalContentAlignment="Center"/>
                <TextBlock Text="模型" Style="{StaticResource FieldLabelStyle}" Margin="0,18,0,7"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ComboBox x:Name="AiModelComboBox" Grid.Column="0" Style="{StaticResource DropDownComboBoxStyle}" VerticalContentAlignment="Center" SelectionChanged="AiModelComboBox_SelectionChanged"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding DisplayText}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox><Button x:Name="GetModelsButton" Grid.Column="1" Content="自动获取模型" Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0" Click="GetModelsButton_Click"/></Grid>
                <Border Background="#F3F8FC" BorderBrush="#D6E4EF" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,18,0,0"><StackPanel><TextBlock Text="请求预览" Foreground="#31546F" FontWeight="SemiBold" FontSize="13"/><TextBlock x:Name="RequestPreviewText" Text="POST /chat/completions" Foreground="#245E91" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" Margin="0,7,0,0"/></StackPanel></Border>

                <Border BorderBrush="#E0E9F1" BorderThickness="0,1,0,0" Margin="0,22,0,0" Padding="0,16,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="DeepSeekConfigStatusText" Text="尚未保存" Foreground="#4E647D" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap"/><Button Grid.Column="1" Content="测试连接" Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0" Click="TestConnectionButton_Click"/><Button Grid.Column="2" Content="保存并启用" Style="{StaticResource PrimaryButtonStyle}" Margin="8,0,0,0" Click="SaveConfigButton_Click"/></Grid></Border>
            </StackPanel></ScrollViewer></Border>
    </Grid>
</Window>
