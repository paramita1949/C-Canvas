<Window x:Class="ImageColorChanger.UI.VersionRollbackWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="版本回退" Height="600" Width="800" MinHeight="460" MinWidth="680"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="White" FontFamily="Microsoft YaHei UI"
        AllowsTransparency="False" WindowStyle="None"
        Loaded="Window_Loaded" Closing="Window_Closing" Closed="Window_Closed">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="7"
                           CornerRadius="10" GlassFrameThickness="0"/>
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <!-- 与升级窗口共用品牌资源与按钮层级。 -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="MinWidth" Value="90"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Background" Value="{StaticResource BrushDialogBrandPrimary}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource BrushDialogBrandHover}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource BrushDialogBrandPressed}"/>
                                <Setter TargetName="border" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#C7CAD1"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TextAction" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#747782"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#F2F3F5"/>
                                <Setter Property="Foreground" Value="#30323A"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource BrushDialogBrandPrimary}"/>
                                <Setter TargetName="border" Property="BorderThickness" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="VersionItem" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#50535E"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/></Grid.ColumnDefinitions>
                                <ContentPresenter VerticalAlignment="Center"/>
                                <TextBlock x:Name="CheckMark" Grid.Column="1" Text="✓" Visibility="Collapsed"
                                           Foreground="{StaticResource BrushDialogBrandPrimary}" HorizontalAlignment="Right"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="border" Property="Background" Value="#F2F3F5"/></Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#EDF3FF"/>
                                <Setter Property="Foreground" Value="{StaticResource BrushDialogBrandPrimary}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="border" Property="BorderBrush" Value="{StaticResource BrushDialogBrandPrimary}"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.6"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border Background="White" CornerRadius="10" BorderBrush="#E6E7EB" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Border x:Name="HeaderBar" Grid.Row="0" Background="White" CornerRadius="10,10,0,0"
                    Padding="20,12" BorderBrush="#ECEEF2" BorderThickness="0,0,0,1" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="版本回退" FontSize="15" FontWeight="SemiBold" Foreground="#24262D" VerticalAlignment="Center"/>
                    <TextBlock x:Name="CurrentVersionText" Grid.Column="1" Margin="20,0,12,0" FontSize="14" Foreground="#92959E" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                    <Button x:Name="CloseButton" Grid.Column="2" Width="30" Padding="0" Style="{StaticResource TextAction}"
                            ToolTip="关闭" AutomationProperties.Name="关闭" Click="CloseButton_Click">
                        <Path Data="M4 4L16 16 M4 16L16 4" Stroke="#8C909A" StrokeThickness="1.5" Width="12" Height="12" Stretch="Uniform"/>
                    </Button>
                </Grid>
            </Border>
            <Grid Grid.Row="1" Margin="20,18,20,16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Grid x:Name="VersionSelectionPanel">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Text="历史版本" FontSize="13" Foreground="#747782" Margin="0,0,0,12"/>
                    <Grid Grid.Row="1">
                        <ListBox x:Name="VersionsListBox" BorderThickness="0" Padding="0" FontSize="14" Background="Transparent"
                                 SelectionMode="Single" HorizontalContentAlignment="Stretch" ItemContainerStyle="{StaticResource VersionItem}"
                                 SelectionChanged="VersionsListBox_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="选择历史版本">
                            <ListBox.Resources><Style TargetType="ScrollBar" BasedOn="{StaticResource CompactScrollBarStyleLight}"/></ListBox.Resources>
                        </ListBox>
                        <TextBlock x:Name="EmptyVersionsText" Text="暂无可回退版本" FontSize="13" Foreground="#92959E" TextWrapping="Wrap" Margin="12,12" Visibility="Collapsed" IsHitTestVisible="False"/>
                    </Grid>
                    <TextBlock Grid.Row="2" Text="仅显示低于当前版本的版本" FontSize="12" Foreground="#92959E" TextWrapping="Wrap" Margin="0,12,0,0"/>
                </Grid>
                <Border Grid.Column="1" Width="1" Background="#ECEEF2" HorizontalAlignment="Center"/>
                <Grid x:Name="ReadmePanel" Grid.Column="2" Margin="8,0,0,0">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock x:Name="ReadmeTitleText" Text="版本说明" FontSize="13" Foreground="#747782" Margin="0,0,0,12"/>
                    <TextBox x:Name="ReadmeTextBox" Grid.Row="1" IsReadOnly="True" TextWrapping="Wrap" FontSize="15" TextBlock.LineHeight="26"
                             Foreground="#50535E" Padding="0,0,8,0" BorderThickness="0" Background="Transparent" Text="选择左侧版本，查看对应说明。"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <TextBox.Resources><Style TargetType="ScrollBar" BasedOn="{StaticResource CompactScrollBarStyleLight}"/></TextBox.Resources>
                    </TextBox>
                </Grid>
            </Grid>
            <StackPanel Grid.Row="2" Margin="20,0,20,12">
                <TextBlock x:Name="StatusText" Text="请选择要回退的版本" FontSize="12" Foreground="#747782" TextWrapping="Wrap"/>
                <Border x:Name="ProgressPanel" Margin="0,8,0,0" Visibility="Collapsed">
                    <StackPanel>
                        <ProgressBar x:Name="DownloadProgress" Height="5" Minimum="0" Maximum="100" Background="#ECEEF2" Foreground="{StaticResource BrushDialogBrandPrimary}"/>
                        <TextBlock x:Name="ProgressDetailText" FontSize="12" Foreground="#92959E" Margin="0,6,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </StackPanel>
            <Border Grid.Row="3" Background="White" CornerRadius="0,0,10,10" Padding="16,12" BorderBrush="#ECEEF2" BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="4,0,12,0">
                        <TextBlock x:Name="TargetVersionText" Text="尚未选择目标版本" FontSize="13" Foreground="#50535E" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="将覆盖程序文件并重启，请先保存工作。" FontSize="12" Foreground="#92959E" Margin="0,5,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="RefreshButton" Content="刷新" Style="{StaticResource TextAction}" Click="RefreshButton_Click"/>
                        <Button x:Name="CancelButton" Content="取消" Style="{StaticResource TextAction}" Click="CloseButton_Click"/>
                        <Button x:Name="RollbackButton" Content="选择回退版本" IsEnabled="False" Style="{StaticResource PrimaryButton}" Click="RollbackButton_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
            <ResizeGrip Grid.Row="3" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,2,2"/>
        </Grid>
    </Border>
</Window>
