<Window x:Class="ImageColorChanger.UI.AiAssistantPanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
        Title="AI面板"
        Width="360"
        Height="500"
        MinWidth="300"
        MinHeight="64"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Microsoft YaHei UI"
        Topmost="False"
        ShowInTaskbar="False"
        SizeChanged="Window_SizeChanged"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <Window.Resources>
        <Style x:Key="HudIconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="#2200B8FF"/>
            <Setter Property="Foreground" Value="#EAF9FF"/>
            <Setter Property="BorderBrush" Value="#447DE7FF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="HudThresholdButtonStyle" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="#EAF9FF"/>
            <Setter Property="Background" Value="#132D44"/>
            <Setter Property="BorderBrush" Value="#4D90C4"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="MinWidth" Value="26"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="ButtonChrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Background" Value="#1C4160"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Background" Value="#2F8CD7"/>
                                <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="#88CAFF"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1C4160"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="#2F8CD7"/>
                    <Setter Property="BorderBrush" Value="#88CAFF"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="HudViewSwitchButtonStyle" BasedOn="{StaticResource HudThresholdButtonStyle}" TargetType="ToggleButton">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="14,4"/>
            <Setter Property="MinWidth" Value="58"/>
        </Style>
        <Style x:Key="HudViewSwitchLeftButtonStyle" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="#EAF9FF"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#4D90C4"/>
            <Setter Property="BorderThickness" Value="0,0,1,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,4"/>
            <Setter Property="MinWidth" Value="54"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="ButtonChrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8,0,0,8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Background" Value="#1C4160"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Background" Value="#2F8CD7"/>
                                <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="#88CAFF"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="HudViewSwitchRightButtonStyle" TargetType="ToggleButton" BasedOn="{StaticResource HudViewSwitchLeftButtonStyle}">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="ButtonChrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="0,8,8,0">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Background" Value="#1C4160"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Background" Value="#2F8CD7"/>
                                <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="#88CAFF"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="HudSpeakerPillButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="MinWidth" Value="122"/>
            <Setter Property="MaxWidth" Value="170"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Foreground" Value="#F4FBFF"/>
            <Setter Property="Background" Value="#132D44"/>
            <Setter Property="BorderBrush" Value="#4D90C4"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonChrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Stretch"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Background" Value="#1C4160"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Background" Value="#2F8CD7"/>
                                <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="#88CAFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SpeakerMenuItemStyle" TargetType="MenuItem">
            <Setter Property="Foreground" Value="#DDF4FF"/>
            <Setter Property="Background" Value="#102234"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1E4261"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="#2F8CD7"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="HudCorrectionTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#F4FBFF"/>
            <Setter Property="CaretBrush" Value="#7FEAFF"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="MaxLines" Value="2"/>
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Hidden"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        </Style>
        <Style x:Key="HudCorrectionSendButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="28"/>
            <Setter Property="MinWidth" Value="48"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Background" Value="#2F8CD7"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#88CAFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonChrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Background" Value="#3AA4F4"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Background" Value="#1E6FAE"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="PanelChromeBorder"
            Background="#C0101A28"
            BorderBrush="#8896E6FF"
            BorderThickness="1"
            CornerRadius="16"
            Padding="10">
        <Border.Effect>
            <DropShadowEffect Color="#206EA8FF"
                              BlurRadius="18"
                              ShadowDepth="0"
                              Opacity="0.45"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0"
                  Margin="0,0,0,8"
                  MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="7" Height="7" Fill="#55E7FF" Margin="0,0,8,0"/>
                    <TextBlock Text="AI面板"
                               Foreground="#F4FBFF"
                               FontSize="15"
                               FontWeight="Bold"
                               VerticalAlignment="Center"/>
                    <Button x:Name="ModelMenuButton"
                            Margin="8,0,0,0"
                            Padding="0"
                            BorderThickness="0"
                            Background="Transparent"
                            Cursor="Hand"
                            ToolTip="点击切换 AI 配置"
                            Click="ModelMenuButton_Click">
                        <Border Background="#223CD7FF"
                                BorderBrush="#558DEAFF"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="7,2">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="ModelNameText"
                                           Text="DeepSeek"
                                           Foreground="#BFEFFF"
                                           FontSize="11"
                                           FontWeight="SemiBold"/>
                                <TextBlock Text=" ▾"
                                           Foreground="#8ED7FF"
                                           FontSize="11"
                                           FontWeight="Bold"/>
                            </StackPanel>
                        </Border>
                    </Button>
                    <primitives:Popup x:Name="ModelPopup"
                                      PlacementTarget="{Binding ElementName=ModelMenuButton}"
                                      Placement="Bottom"
                                      VerticalOffset="6"
                                      AllowsTransparency="True"
                                      StaysOpen="False"
                                      PopupAnimation="Fade">
                        <Border Background="#071C30"
                                BorderBrush="#7366B8EA"
                                BorderThickness="1"
                                CornerRadius="7"
                                Padding="6">
                            <ScrollViewer MaxHeight="280"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <StackPanel x:Name="ModelProfileOptionsPanel"/>
                            </ScrollViewer>
                        </Border>
                    </primitives:Popup>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="CollapseButton"
                            Content="▾"
                            ToolTip="折叠/展开"
                            Style="{StaticResource HudIconButtonStyle}"
                            Click="CollapseButton_Click"/>
                    <Button Content="结"
                            ToolTip="结束本场并结算消耗"
                            Style="{StaticResource HudIconButtonStyle}"
                            Margin="6,0,0,0"
                            Click="EndSessionButton_Click"/>
                    <Button Content="清"
                            ToolTip="清空实时信息流"
                            Style="{StaticResource HudIconButtonStyle}"
                            Margin="6,0,0,0"
                            Click="ClearButton_Click"/>
                    <Button Content="×"
                            ToolTip="隐藏面板（不结束本场）"
                            Style="{StaticResource HudIconButtonStyle}"
                            Margin="6,0,0,0"
                            Click="CloseButton_Click"/>
                </StackPanel>
            </Grid>

            <Grid x:Name="CollapsedInfoGrid"
                  Grid.Row="1"
                  Visibility="Collapsed"
                  Margin="2,0,2,0"
                  MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Border Background="#141B3F5C"
                        BorderBrush="#335FAFE6"
                        BorderThickness="1"
                        CornerRadius="9"
                        Padding="10,7">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="CollapsedStatusText"
                                   Text="等待幻灯片 / 实时识别"
                                   Foreground="#BFEFFF"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   TextWrapping="NoWrap"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="CollapsedScriptureText"
                                   Grid.Row="1"
                                   Visibility="Collapsed"
                                   Foreground="#7FEAFF"
                                   FontSize="11"
                                   TextWrapping="NoWrap"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,4,0,0"/>
                    </Grid>
                </Border>
            </Grid>

            <Grid x:Name="MetaSectionGrid"
                  Grid.Row="1"
                  Margin="0,0,0,10"
                  MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Row="0"
                        Grid.RowSpan="2"
                        Grid.Column="0"
                        Margin="0"
                        Padding="0"
                        BorderBrush="#4D90C4"
                        BorderThickness="1"
                        CornerRadius="10"
                        Background="#0E2A43"
                        ClipToBounds="True">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0"
                              Background="#123A59"
                              MinHeight="42">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Button x:Name="SpeakerMenuButton"
                                    ToolTip="切换传道人"
                                    Style="{StaticResource HudSpeakerPillButtonStyle}"
                                    Margin="10,5,0,5"
                                    Click="SpeakerMenuButton_Click">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Viewbox Width="15"
                                             Height="15"
                                             VerticalAlignment="Center">
                                        <Canvas Width="24" Height="24">
                                            <Ellipse Canvas.Left="8"
                                                     Canvas.Top="4"
                                                     Width="8"
                                                     Height="8"
                                                     Stroke="#8FB8D1"
                                                     StrokeThickness="2"/>
                                            <Path Data="M4,21 C5.5,16 18.5,16 20,21"
                                                  Stroke="#8FB8D1"
                                                  StrokeThickness="2"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round"
                                                  Fill="Transparent"/>
                                            <Path Data="M18.5,5.5 L21,3 M21,3 L21,7 M21,3 L17,3"
                                                  Stroke="#8FB8D1"
                                                  StrokeThickness="1.7"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round"
                                                  StrokeLineJoin="Round"
                                                  Fill="Transparent"/>
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock x:Name="SpeakerSelectionText"
                                               Grid.Column="2"
                                               Text=""
                                               Foreground="#F4FBFF"
                                               FontSize="12"
                                               FontWeight="Bold"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>
                                </Grid>
                            </Button>

                            <primitives:Popup x:Name="SpeakerPopup"
                                              PlacementTarget="{Binding ElementName=SpeakerMenuButton}"
                                              Placement="Bottom"
                                              VerticalOffset="6"
                                              AllowsTransparency="True"
                                              StaysOpen="False"
                                              PopupAnimation="Fade">
                                <Border x:Name="SpeakerPopupRoot"
                                        Width="248"
                                        MaxHeight="340"
                                        Background="#071C30"
                                        BorderBrush="#7366B8EA"
                                        BorderThickness="1"
                                        CornerRadius="7"
                                        SnapsToDevicePixels="True">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#99000000"
                                                          BlurRadius="14"
                                                          ShadowDepth="4"
                                                          Opacity="0.45"/>
                                    </Border.Effect>
                                    <StackPanel x:Name="SpeakerPopupStack"/>
                                </Border>
                            </primitives:Popup>

                            <Border Grid.Column="1"
                                    BorderBrush="#4D90C4"
                                    BorderThickness="1"
                                    CornerRadius="9"
                                    Background="#132D44"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Height="32"
                                    Margin="8,0,10,0"
                                    ClipToBounds="True">
                                <UniformGrid Rows="1" Columns="2">
                                    <ToggleButton x:Name="RealtimeViewButton"
                                                  Content="实时"
                                                  IsChecked="True"
                                                  MinWidth="54"
                                                  Height="30"
                                                  Style="{StaticResource HudViewSwitchLeftButtonStyle}"
                                                  Checked="ViewModeToggleButton_Checked"/>
                                    <ToggleButton x:Name="HistoryViewButton"
                                                  Content="历史"
                                                  MinWidth="54"
                                                  Height="30"
                                                  Style="{StaticResource HudViewSwitchRightButtonStyle}"
                                                  Checked="ViewModeToggleButton_Checked"/>
                                </UniformGrid>
                            </Border>
                        </Grid>

                        <Grid Grid.Row="1"
                              Margin="12,10,12,12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="ProjectTitleText"
                                           Text="主题待读取"
                                           Foreground="#F4FBFF"
                                           FontSize="14"
                                           FontWeight="Bold"
                                           VerticalAlignment="Center"/>
                                <TextBlock x:Name="StatusText"
                                           Grid.Column="1"
                                           Text="等待幻灯片 / 实时识别"
                                           Foreground="#9FC0D6"
                                           FontSize="11"
                                           TextWrapping="NoWrap"
                                           TextTrimming="CharacterEllipsis"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"
                                           Margin="10,1,0,0"/>
                            </Grid>

                            <Grid Grid.Row="1"
                                  Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="显示"
                                               Foreground="#8FB8D1"
                                               FontSize="11"
                                               VerticalAlignment="Center"
                                               Margin="0,0,6,0"/>
                                    <Border Background="#132D44"
                                            BorderBrush="#4D90C4"
                                            BorderThickness="1"
                                            CornerRadius="9"
                                            Padding="0">
                                        <UniformGrid Rows="1" Columns="2">
                                            <ToggleButton x:Name="ConciseModeButton"
                                                          Content="简洁"
                                                          IsChecked="True"
                                                          Style="{StaticResource HudThresholdButtonStyle}"
                                                          Checked="OutputModeToggleButton_Checked"/>
                                            <ToggleButton x:Name="DetailedModeButton"
                                                          Content="详细"
                                                          Style="{StaticResource HudThresholdButtonStyle}"
                                                          Checked="OutputModeToggleButton_Checked"/>
                                        </UniformGrid>
                                    </Border>
                                </StackPanel>

                                <TextBlock x:Name="BalanceStatusText"
                                           Grid.Column="1"
                                           Text="余额：待查询，消耗：待计算"
                                           Foreground="#9FC0D6"
                                           FontSize="11"
                                           TextWrapping="NoWrap"
                                           TextTrimming="CharacterEllipsis"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"
                                           Margin="8,0,0,0"/>
                            </Grid>

                            <Grid Grid.Row="2"
                                  Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="阈值"
                                               Foreground="#8FB8D1"
                                               FontSize="11"
                                               VerticalAlignment="Center"
                                               Margin="0,0,6,0"/>
                                    <Border BorderBrush="#4D90C4"
                                            BorderThickness="1"
                                            CornerRadius="7"
                                            Background="#132D44">
                                        <UniformGrid Rows="1" Columns="3">
                                            <ToggleButton x:Name="ThresholdLowButton"
                                                          Content="低"
                                                          ToolTipService.ShowDuration="20000"
                                                          Style="{StaticResource HudThresholdButtonStyle}"
                                                          Checked="ThresholdToggleButton_Checked"/>
                                            <ToggleButton x:Name="ThresholdMidButton"
                                                          Content="中"
                                                          ToolTipService.ShowDuration="20000"
                                                          Style="{StaticResource HudThresholdButtonStyle}"
                                                          Checked="ThresholdToggleButton_Checked"/>
                                            <ToggleButton x:Name="ThresholdHighButton"
                                                          Content="高"
                                                          ToolTipService.ShowDuration="20000"
                                                          Style="{StaticResource HudThresholdButtonStyle}"
                                                          Checked="ThresholdToggleButton_Checked"/>
                                        </UniformGrid>
                                    </Border>
                                </StackPanel>

                                <StackPanel Grid.Column="1"
                                            Orientation="Horizontal"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Margin="12,0,0,0">
                                    <TextBlock Text="透明"
                                               Foreground="#8FB8D1"
                                               FontSize="11"
                                               VerticalAlignment="Center"
                                               Margin="0,0,6,0"/>
                                    <Slider x:Name="PanelOpacitySlider"
                                            Width="70"
                                            Minimum="35"
                                            Maximum="100"
                                            TickFrequency="5"
                                            Value="80"
                                            IsSnapToTickEnabled="True"
                                            ToolTip="调节面板背景透明度"
                                            ValueChanged="PanelOpacitySlider_ValueChanged"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <Border x:Name="MessageContainerBorder"
                    Grid.Row="2"
                    Background="#9C091423"
                    BorderBrush="#5C93E2FF"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="8">
                <Grid>
                    <Grid x:Name="RealtimeContentGrid">
                        <ScrollViewer x:Name="MessageScrollViewer"
                                      SizeChanged="MessageScrollViewer_SizeChanged"
                                      VerticalScrollBarVisibility="Hidden"
                                      HorizontalScrollBarVisibility="Hidden">
                            <StackPanel x:Name="MessageStackPanel"/>
                        </ScrollViewer>
                        <StackPanel x:Name="EmptyStatePanel"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Width="220">
                            <TextBlock Text="AI信息流"
                                       Foreground="#F4FBFF"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       TextAlignment="Center"/>
                            <TextBlock Text="主题、字幕、经文候选和写入状态会显示在这里。"
                                       Foreground="#93B4CC"
                                       FontSize="12"
                                       LineHeight="18"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"
                                       Margin="0,8,0,0"/>
                        </StackPanel>
                    </Grid>
                    <Grid x:Name="HistoryContentGrid" Visibility="Collapsed">
                        <ScrollViewer x:Name="HistoryScrollViewer"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="HistoryStackPanel"/>
                        </ScrollViewer>
                        <StackPanel x:Name="HistoryEmptyStatePanel"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Width="230">
                            <TextBlock Text="暂无历史"
                                       Foreground="#F4FBFF"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       TextAlignment="Center"/>
                            <TextBlock Text="开启AI解读后，会按传道人沉淀本场摘要和对话记录。"
                                       Foreground="#93B4CC"
                                       FontSize="12"
                                       LineHeight="18"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"
                                       Margin="0,8,0,0"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <Border x:Name="ManualContextGrid"
                    Grid.Row="3"
                    Margin="0,8,0,0"
                    Background="#74101F30"
                    BorderBrush="#4D90C4"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="8,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0"
                          Margin="0,0,8,0">
                        <TextBox x:Name="ManualContextTextBox"
                                 Style="{StaticResource HudCorrectionTextBoxStyle}"
                                 ToolTip="补充本场主题、讲员表达或经文修正，Ctrl+Enter发送，回车换行"
                                 TextChanged="ManualContextTextBox_TextChanged"
                                 KeyDown="ManualContextTextBox_KeyDown"/>
                        <TextBlock x:Name="ManualContextPlaceholder"
                                   Text="补充本场线索，例如：讲员刚才在讲家庭与下一代，也可修正经文"
                                   Foreground="#739FC0D6"
                                   FontSize="11"
                                   VerticalAlignment="Center"
                                   Margin="1,0,0,0"
                                   TextTrimming="CharacterEllipsis"
                                   IsHitTestVisible="False"/>
                    </Grid>
                    <Button Grid.Column="1"
                            Content="发送"
                            Style="{StaticResource HudCorrectionSendButtonStyle}"
                            Click="ManualContextSendButton_Click"/>
                </Grid>
            </Border>

        </Grid>
    </Border>
</Window>
