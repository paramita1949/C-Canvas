<UserControl x:Class="ImageColorChanger.UI.Views.MediaPlayerSectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border x:Name="MediaPlayerPanel"
            Background="#2C2C2C"
            BorderBrush="#404040"
            BorderThickness="0,1,0,0"
            Padding="15,10"
            Visibility="Collapsed">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="BtnMediaPrev"
                        Width="40"
                        Height="40"
                        ToolTip="上一首"
                        Style="{StaticResource MaterialDesignFloatingActionMiniButton}">
                    <Path Data="{StaticResource IconLucideSkipBack}"
                          Style="{StaticResource LucideIconPathStyle}"
                          Stroke="White"/>
                </Button>

                <Button x:Name="BtnMediaPlayPause"
                        Width="50"
                        Height="50"
                        Margin="10,0"
                        ToolTip="播放/暂停"
                        Style="{StaticResource MaterialDesignFloatingActionButton}">
                    <Path Data="{StaticResource IconLucidePlay}"
                          Style="{StaticResource LucideIconPathStyle}"
                          Width="20"
                          Height="20"
                          Stroke="White"/>
                </Button>

                <Button x:Name="BtnMediaNext"
                        Width="40"
                        Height="40"
                        ToolTip="下一首"
                        Style="{StaticResource MaterialDesignFloatingActionMiniButton}">
                    <Path Data="{StaticResource IconLucideSkipForward}"
                          Style="{StaticResource LucideIconPathStyle}"
                          Stroke="White"/>
                </Button>

            </StackPanel>

            <Grid Grid.Column="1" Margin="20,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Slider x:Name="MediaProgressSlider"
                        Grid.Row="0"
                        VerticalAlignment="Center"
                        Margin="0,0,0,5"
                        Minimum="0"
                        Maximum="100"
                        Value="0"/>

                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock x:Name="MediaCurrentTime" Text="00:00" Foreground="White" FontSize="12"/>
                    <TextBlock Text=" / " Foreground="#999999" FontSize="12" Margin="5,0"/>
                    <TextBlock x:Name="MediaTotalTime" Text="00:00" Foreground="White" FontSize="12"/>
                </StackPanel>
            </Grid>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="BtnPlayMode"
                        Width="40"
                        Height="40"
                        ToolTip="左键切换模式，右键直接选择"
                        Style="{StaticResource MaterialDesignFloatingActionMiniButton}">
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem x:Name="MenuMediaPlayModeRandom"
                                      Header="随机播放" Tag="Random"
                                      IsCheckable="True"/>
                            <MenuItem x:Name="MenuMediaPlayModeLoopOne"
                                      Header="单曲循环" Tag="LoopOne"
                                      IsCheckable="True"/>
                            <MenuItem x:Name="MenuMediaPlayModeLoopAll"
                                      Header="歌单循环" Tag="LoopAll"
                                      IsCheckable="True"/>
                        </ContextMenu>
                    </Button.ContextMenu>
                    <Path Data="{StaticResource IconLucideShuffle}"
                          Style="{StaticResource LucideIconPathStyle}"
                          Stroke="White"/>
                </Button>

                <Path Data="{StaticResource IconLucideVolume2}"
                      Style="{StaticResource LucideIconPathStyle}"
                      Width="18"
                      Height="18"
                      VerticalAlignment="Center"
                      Stroke="White"
                      Margin="15,0,5,0"/>

                <Slider x:Name="VolumeSlider"
                        Width="100"
                        VerticalAlignment="Center"
                        Minimum="0"
                        Maximum="100"
                        Value="50"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>

